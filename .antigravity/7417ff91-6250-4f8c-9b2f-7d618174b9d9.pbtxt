  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Lab, Reservation } from \'../types\';\nimport { SOFTWARE_CATEGORIES } from \'../data/mockData\';\n\ninterface ReservationWizardProps {\n  labs: Lab[];\n  onFinishReservation: (newReservation: Reservation) => void;\n  onCancel: () => void;\n  initialLabId?: string | null;\n  activeReservationForTicket?: Reservation | null;\n}\n\nexport const ReservationWizard: React.FC<ReservationWizardProps> = ({\n  labs,\n  onFinishReservation,\n  onCancel,\n  initialLabId,\n  activeReservationForTicket,\n}) => {\n  // If an active ticket is passed to view directly, start at step 3!\n  const [step, setStep] = useState<1 | 2 | 3>(activeReservationForTicket ? 3 : 1);\n\n  // Step 1 Form States\n  const [discipline, setDiscipline] = useState(\'Desenvolvimento Web & Mobile\');\n  const [targetClass, setTargetClass] = useState(\'Turma B - Noturno (Eng. Computa\303\247\303\243o)\');\n  const [studentsCount, setStudentsCount] = useState(32);\n\n  // Dates carousel options\n  const dateOptions = [\n    { label: \'QUA\', day: \'25\', full: \'Qua, 25 de Outubro\', dateVal: \'2023-10-25\' },\n    { label: \'QUI\', day: \'26\', full: \'Qui, 26 de Outubro\', dateVal: \'2023-10-26\' },\n    { label: \'SEX\', day: \'27\', full: \'Sex, 27 de Outubro\', dateVal: \'2023-10-27\' },\n    { label: \'SEG\', day: \'30\', full: \'Seg, 30 de Outubro\', dateVal: \'2023-10-30\' },\n    { label: \'TER\', day: \'31\', full: \'Ter, 31 de Outubro\', dateVal: \'2023-10-31\' },\n    { label: \'QUA\', day: \'01\', full: \'Qua, 01 de Novembro\', dateVal: \'2023-11-01\' },\n  ];\n  const [selectedDateObj, setSelectedDateObj] = useState(dateOptions[2]); // Friday 27 default\n\n  const [startTime, setStartTime] = useState(\'14:00\');\n  const [endTime, setEndTime] = useState(\'17:30\');\n\n  // Selected software list\n  const [selectedSoftwares, setSelectedSoftwares] = useState<string[]>([\n    \'VS Code\',\n    \'Android Studio\',\n    \'PostgreSQL / DBeaver\',\n  ]);\n  const [customSoftware, setCustomSoftware] = useState(\'\');\n\n  // Step 2 Lab Selection States\n  const [selectedLabId, setSelectedLabId] = useState<string>(initialLabId || \'lab-04\');\n  const [requiresITSetup, setRequiresITSetup] = useState<boolean>(false);\n\n  // Step 3 Ticket State\n  const [confirmedReservation, setConfirmedReservation] = useState<Reservation | null>(\n    activeReservationForTicket || null\n  );\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  // Handle software tag toggle\n  const toggleSoftware = (name: string) => {\n    setSelectedSoftwares((prev) =>\n      prev.includes(name) ? prev.filter((s) => s !== name) : [...prev, name]\n    );\n  };\n\n  // Adjust students count\n  const handleStudentChange = (newVal: number) => {\n    const clamped = Math.max(1, Math.min(50, newVal));\n    setStudentsCount(clamped);\n  };\n\n  // Calculate duration string\n  const calculateDuration = (start: string, end: string) => {\n    const [startH, startM] = start.split(\':\').map(Number);\n    const [endH, endM] = end.split(\':\').map(Number);\n    let diffMinutes = endH * 60 + endM - (startH * 60 + startM);\n    if (diffMinutes < 0) diffMinutes += 24 * 60;\n    const hours = Math.floor(diffMinutes / 60);\n    const minutes = diffMinutes % 60;\n    return `${hours}h${minutes > 0 ? ` ${minutes}min` : \'\'}`;\n  };\n\n  // Move from Step 1 to Step 2\n  const handleProceedToStep2 = () => {\n    setStep(2);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  // Move from Step 2 to Step 3 (Confirm booking)\n  const handleConfirmReservation = () => {\n    const chosenLab = labs.find((l) => l.id === selectedLabId) || labs[0];\n    const duration = calculateDuration(startTime, endTime);\n    const randomProtocolNum = Math.floor(1000 + Math.random() * 9000);\n    const protocolCode = `#LR-2023-${randomProtocolNum}`;\n    const qrCodeVal = `LR-${Math.floor(1000 + Math.random() * 9000)}-${chosenLab.id.substring(0, 2).toUpperCase()}`;\n\n    const newRes: Reservation = {\n      id: `res-${Date.now()}`,\n      protocol: protocolCode,\n      subject: discipline,\n      course: \'Engenharia de Computa\303\247\303\243o\',\n      assignedClass: targetClass,\n      professorName: \'Prof. Dr. Andr\303\251 Silva\',\n      siape: \'198421\',\n      labId: chosenLab.id,\n      labName: chosenLab.name,\n      location: `${chosenLab.block}, ${chosenLab.roomNumber}`,\n      studentsCount: studentsCount,\n      totalStations: chosenLab.totalComputers,\n      dateStr: selectedDateObj.dateVal,\n      dateFormatted: selectedDateObj.full,\n      startTime: startTime,\n      endTime: endTime,\n      durationStr: duration,\n      requiredSoftware: selectedSoftwares,\n      extraSoftware: customSoftware.trim() || undefined,\n      status: requiresITSetup ? \'aguardando_ti\' : \'confirmada\',\n      requiresItSupport: requiresITSetup,\n      itTicket: requiresITSetup\n        ? {\n            id: `#${Math.floor(4000 + Math.random() * 2000)}`,\n            description: `Instala\303\247\303\243o de depend\303\252ncias adicionais no ${chosenLab.name}`,\n            estimatedTime: \'~2 horas\',\n            status: \'em_andamento\',\n          }\n        : undefined,\n      qrCodeText: qrCodeVal,\n      createdAt: new Date().toISOString(),\n    };\n\n    setConfirmedReservation(newRes);\n    onFinishReservation(newRes);\n    setStep(3);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  // Copy Protocol to Clipboard\n  const handleCopyProtocol = () => {\n    const text = confirmedReservation?.protocol || \'#LR-2023-8941\';\n    navigator.clipboard.writeText(text);\n    setToastMessage(\'C\303\263digo copiado com sucesso!\');\n    setTimeout(() => setToastMessage(null), 2500);\n  };\n\n  // Add to Calendar intent\n  const handleAddToCalendar = () => {\n    if (!confirmedReservation) return;\n    const title = encodeURIComponent(`Reserva: ${confirmedReservation.labName} - ${confirmedReservation.subject}`);\n    const details = encodeURIComponent(\n      `Aloca\303\247\303\243o de laborat\303\263rio para ${confirmedReservation.studentsCount} alunos. Protocolo: ${confirmedReservation.protocol}. Chave Digital: ${confirmedReservation.qrCodeText}`\n    );\n    const location = encodeURIComponent(`${confirmedReservation.location} - Campus Universit\303\241rio`);\n    const dateFormattedClean = confirmedReservation.dateStr.replace(/-/g, \'\');\n    const startTimeClean = confirmedReservation.startTime.replace(\':\', \'\') + \'00\';\n    const endTimeClean = confirmedReservation.endTime.replace(\':\', \'\') + \'00\';\n    const dates = `${dateFormattedClean}T${startTimeClean}Z/${dateFormattedClean}T${endTimeClean}Z`;\n\n    const calUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&details=${details}&location=${location}&dates=${dates}`;\n    window.open(calUrl, \'_blank\');\n  };\n\n  // Share Ticket\n  const handleShareTicket = () => {\n    if (!confirmedReservation) return;\n    if (navigator.share) {\n      navigator\n        .share({\n          title: `Comprovante LabReserve - ${confirmedReservation.labName}`,\n          text: `Reserva confirmada no ${confirmedReservation.labName} (${confirmedReservation.location}) - ${confirmedReservation.dateFormatted} das ${confirmedReservation.startTime} \303\240s ${confirmedReservation.endTime}. Protocolo: ${confirmedReservation.protocol}`,\n          url: window.location.href,\n        })\n        .catch(() => {});\n    } else {\n      handleCopyProtocol();\n    }\n  };\n\n  // ==========================================\n  // RENDER STEP 1: REQUISITOS (PAR\303\202METROS DE AULA)\n  // Matches Image_3_fd8c7b89.png / Image_4_47388297.html\n  // ==========================================\n  if (step === 1) {\n    return (\n      <div className=\"flex flex-col w-full px-margin pb-24 space-y-space-lg\">\n        {/* Stepper de Progresso */}\n        <section className=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-sm border border-outline-variant/20\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-space-xs text-primary font-label-md\">\n              <span className=\"material-symbols-outlined text-[18px]\">tune</span>\n              <span>Passo 1 de 3</span>\n            </div>\n            <span className=\"font-label-sm text-on-surface-variant font-medium\">Par\303\242metros de Aula</span>\n          </div>\n\n          {/* Barra de Progresso com Preenchimento Din\303\242mico */}\n          <div className=\"w-full bg-surface-container-high h-2 rounded-full overflow-hidden\">\n            <div className=\"bg-primary-container h-full w-1/3 rounded-full transition-all duration-300\"></div>\n          </div>\n\n          <div className=\"flex justify-between items-center text-on-surface-variant font-label-sm pt-1\">\n            <span className=\"text-primary font-label-md font-bold\">1. Requisitos</span>\n            <span>2. Escolha da Sala</span>\n            <span>3. Confirma\303\247\303\243o</span>\n          </div>\n        </section>\n\n        {/* Contexto Acad\303\252mico: Disciplina e Turma */}\n        <section className=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-md border border-outline-variant/20\">\n          <div className=\"flex items-center gap-space-sm text-primary\">\n            <div className=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center\">\n              <span className=\"material-symbols-outlined text-primary text-[20px]\">school</span>\n            </div>\n            <div>\n              <h2 className=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Dados da Disciplina</h2>\n              <p className=\"font-body-sm text-body-sm text-on-surface-variant\">Informe o plano de aula para aloca\303\247\303\243o</p>\n            </div>\n          </div>\n\n          {/* Select Disciplina */}\n          <div className=\"space-y-space-xs\">\n            <label className=\"font-label-md text-label-md text-on-surface font-semibold\" htmlFor=\"select-disciplina\">\n              Mat\303\251ria / Disciplina\n            </label>\n            <div className=\"relative\">\n              <select\n                className=\"w-full h-12 pl-4 pr-10 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md appearance-none focus:outline-none focus:bg-surface-container-high transition-colors\"\n                id=\"select-disciplina\"\n                value={discipline}\n                onChange={(e) => setDiscipline(e.target.value)}\n              >\n                <option value=\"Desenvolvimento Web & Mobile\">Desenvolvimento Web & Mobile</option>\n                <option value=\"Banco de Dados II\">Banco de Dados II</option>\n                <option value=\"Engenharia de Software\">Engenharia de Software</option>\n                <option value=\"Sistemas Distribu\303\255dos\">Sistemas Distribu\303\255dos</option>\n                <option value=\"Intelig\303\252ncia Artificial\">Intelig\303\252ncia Artificial</option>\n                <option value=\"Estrutura de Dados e Algoritmos\">Estrutura de Dados e Algoritmos</option>\n              </select>\n              <span className=\"material-symbols-outlined absolute right-3 top-3 text-on-surface-variant pointer-events-none text-[20px]\">\n                expand_more\n              </span>\n            </div>\n          </div>\n\n          {/* Select Turma */}\n          <div className=\"space-y-space-xs\">\n            <label className=\"font-label-md text-label-md text-on-surface font-semibold\" htmlFor=\"select-turma\">\n              Turma Designada\n            </label>\n            <div className=\"relative\">\n              <select\n                className=\"w-full h-12 pl-4 pr-10 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md appearance-none focus:outline-none focus:bg-surface-container-high transition-colors\"\n                id=\"select-turma\"\n                value={targetClass}\n                onChange={(e) => setTargetClass(e.target.value)}\n              >\n                <option value=\"Turma B - Noturno (Eng. Computa\303\247\303\243o)\">Turma B - Noturno (Eng. Computa\303\247\303\243o)</option>\n                <option value=\"Turma A - Matutino (Sistemas de Informa\303\247\303\243o)\">Turma A - Matutino (Sistemas de Informa\303\247\303\243o)</option>\n                <option value=\"Turma C - Vespertino (Ci\303\252ncia da Computa\303\247\303\243o)\">Turma C - Vespertino (Ci\303\252ncia da Computa\303\247\303\243o)</option>\n                <option value=\"Turma D - Noturno (Engenharia de Software)\">Turma D - Noturno (Engenharia de Software)</option>\n              </select>\n              <span className=\"material-symbols-outlined absolute right-3 top-3 text-on-surface-variant pointer-events-none text-[20px]\">\n                groups\n              </span>\n            </div>\n          </div>\n        </section>\n\n        {/* Lota\303\247\303\243o e Capacidade Necess\303\241ria */}\n        <section className=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-md border border-outline-variant/20\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-space-sm text-primary\">\n              <div className=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-primary text-[20px]\">person_check</span>\n              </div>\n              <div>\n                <h2 className=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Quantidade de Alunos</h2>\n                <p className=\"font-body-sm text-body-sm text-on-surface-variant\">Postos de trabalho necess\303\241rios</p>\n              </div>\n            </div>\n            <span className=\"bg-secondary-container text-on-secondary-container font-label-sm text-label-sm px-2.5 py-1 rounded-full flex items-center gap-1 font-bold\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-secondary\"></span>\n              1:1 Aluno/PC\n            </span>\n          </div>\n\n          {/* Card Contador Din\303\242mico */}\n          <div className=\"bg-surface-container-low p-space-md rounded-xl flex items-center justify-between\">\n            <button\n              aria-label=\"Diminuir alunos\"\n              className=\"w-11 h-11 rounded-lg bg-surface-container-lowest text-on-surface flex items-center justify-center shadow-sm active:scale-95 transition-transform cursor-pointer\"\n              id=\"btn-decrement\"\n              type=\"button\"\n              onClick={() => handleStudentChange(studentsCount - 1)}\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">remove</span>\n            </button>\n            <div className=\"flex flex-col items-center\">\n              <span className=\"font-display-lg text-display-lg text-primary leading-none font-bold\" id=\"student-count-display\">\n                {studentsCount}\n              </span>\n              <span className=\"font-label-sm text-label-sm text-on-surface-variant mt-0.5\">esta\303\247\303\265es ativas</span>\n            </div>\n            <button\n              aria-label=\"Aumentar alunos\"\n              className=\"w-11 h-11 rounded-lg bg-surface-container-lowest text-on-surface flex items-center justify-center shadow-sm active:scale-95 transition-transform cursor-pointer\"\n              id=\"btn-increment\"\n              type=\"button\"\n              onClick={() => handleStudentChange(studentsCount + 1)}\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">add</span>\n            </button>\n          </div>\n\n          {/* Slider de Ajuste Fino */}\n          <div className=\"space-y-space-xs pt-1\">\n            <div className=\"flex justify-between font-label-sm text-label-sm text-on-surface-variant\">\n              <span>Min: 1</span>\n              <span>Ajuste R\303\241pido</span>\n              <span>M\303\241x: 50</span>\n            </div>\n            <input\n              className=\"w-full accent-primary-container h-2 bg-surface-container rounded-lg cursor-pointer\"\n              id=\"student-slider\"\n              max={50}\n              min={1}\n              type=\"range\"\n              value={studentsCount}\n              onChange={(e) => handleStudentChange(parseInt(e.target.value, 10))}\n            />\n          </div>\n\n          {/* Aviso Din\303\242mico Inteligente */}\n          <div className=\"bg-surface-container-high p-space-sm rounded-lg flex items-center gap-space-sm text-on-surface\" id=\"capacity-warning\">\n            <span className=\"material-symbols-outlined text-primary text-[20px] shrink-0\">info</span>\n            <p className=\"font-body-sm text-body-sm\" id=\"capacity-warning-text\">\n              Recomendado labs com no m\303\255nimo <strong>{studentsCount + 3} esta\303\247\303\265es</strong> (reserva de margem).\n            </p>\n          </div>\n        </section>\n\n        {/* Data e Hor\303\241rios de Uso */}\n        <section className=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-md border border-outline-variant/20\">\n          <div className=\"flex items-center gap-space-sm text-primary\">\n            <div className=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center\">\n              <span className=\"material-symbols-outlined text-primary text-[20px]\">event</span>\n            </div>\n            <div>\n              <h2 className=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Data e Hor\303\241rio</h2>\n              <p className=\"font-body-sm text-body-sm text-on-surface-variant\">Selecione o dia e o bloco de aulas</p>\n            </div>\n          </div>\n\n          {/* Carrossel Horizontal de Datas */}\n          <div className=\"space-y-space-xs\">\n            <span className=\"font-label-md text-label-md text-on-surface\">\n              Data Selecionada: <strong className=\"text-primary\">{selectedDateObj.full}</strong>\n            </span>\n            <div className=\"flex gap-2 overflow-x-auto pb-2 pt-1 -mx-2 px-2 no-scrollbar\">\n              {dateOptions.map((opt) => {\n                const isSelected = opt.dateVal === selectedDateObj.dateVal;\n                return (\n                  <button\n                    key={opt.dateVal}\n                    className={`date-chip flex-shrink-0 w-16 py-2.5 rounded-xl flex flex-col items-center gap-0.5 transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-primary text-on-primary shadow-sm scale-105\'\n                        : \'bg-surface-container-low text-on-surface hover:bg-surface-container\'\n                    }`}\n                    type=\"button\"\n                    onClick={() => setSelectedDateObj(opt)}\n                  >\n                    <span className={`font-label-sm text-label-sm ${isSelected ? \'opacity-90 font-bold\' : \'opacity-80\'}`}>\n                      {opt.label}\n                    </span>\n                    <span className=\"font-headline-sm text-headline-sm font-bold\">{opt.day}</span>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Bloco de In\303\255cio e T\303\251rmino */}\n          <div className=\"grid grid-cols-2 gap-space-sm pt-1\">\n            <div className=\"space-y-space-xs\">\n              <label className=\"font-label-md text-label-md text-on-surface font-semibold\" htmlFor=\"time-start\">\n                Hor\303\241rio In\303\255cio\n              </label>\n              <div className=\"relative\">\n                <select\n                  className=\"w-full h-12 pl-3 pr-8 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md appearance-none focus:outline-none\"\n                  id=\"time-start\"\n                  value={startTime}\n                  onChange={(e) => setStartTime(e.target.value)}\n                >\n                  <option value=\"08:00\">08:00</option>\n                  <option value=\"10:00\">10:00</option>\n                  <option value=\"13:30\">13:30</option>\n                  <option value=\"14:00\">14:00</option>\n                  <option value=\"15:00\">15:00</option>\n                  <option value=\"18:30\">18:30</option>\n                  <option value=\"19:15\">19:15</option>\n                </select>\n                <span className=\"material-symbols-outlined absolute right-2.5 top-3 text-on-surface-variant pointer-events-none text-[18px]\">\n                  schedule\n                </span>\n              </div>\n            </div>\n\n            <div className=\"space-y-space-xs\">\n              <label className=\"font-label-md text-label-md text-on-surface font-semibold\" htmlFor=\"time-end\">\n                Hor\303\241rio T\303\251rmino\n              </label>\n              <div className=\"relative\">\n                <select\n                  className=\"w-full h-12 pl-3 pr-8 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md appearance-none focus:outline-none\"\n                  id=\"time-end\"\n                  value={endTime}\n                  onChange={(e) => setEndTime(e.target.value)}\n                >\n                  <option value=\"10:00\">10:00</option>\n                  <option value=\"12:00\">12:00</option>\n                  <option value=\"16:00\">16:00</option>\n                  <option value=\"17:00\">17:00</option>\n                  <option value=\"17:30\">17:30</option>\n                  <option value=\"21:00\">21:00</option>\n                  <option value=\"22:00\">22:00</option>\n                </select>\n                <span className=\"material-symbols-outlined absolute right-2.5 top-3 text-on-surface-variant pointer-events-none text-[18px]\">\n                  timelapse\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Badge Autom\303\241tico de Dura\303\247\303\243o */}\n          <div className=\"flex items-center justify-between bg-surface-container-high px-space-md py-2.5 rounded-lg\">\n            <span className=\"font-label-sm text-label-sm text-on-surface-variant\">Tempo total de ocupa\303\247\303\243o</span>\n            <span className=\"bg-primary-fixed text-on-primary-fixed font-label-md text-label-md px-3 py-1 rounded-full flex items-center gap-1 font-bold\">\n              <span className=\"material-symbols-outlined text-[16px]\">hourglass_top</span>\n              Dura\303\247\303\243o: {calculateDuration(startTime, endTime)}\n            </span>\n          </div>\n        </section>\n\n        {/* Softwares Espec\303\255ficos Necess\303\241rios */}\n        <section className=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-md border border-outline-variant/20\">\n          <div className=\"flex items-center gap-space-sm text-primary\">\n            <div className=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center\">\n              <span className=\"material-symbols-outlined text-primary text-[20px]\">terminal</span>\n            </div>\n            <div>\n              <h2 className=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Softwares & Ambiente</h2>\n              <p className=\"font-body-sm text-body-sm text-on-surface-variant\">Filtre laborat\303\263rios com a pilha pronta</p>\n            </div>\n          </div>\n\n          {SOFTWARE_CATEGORIES.map((cat) => (\n            <div key={cat.id} className=\"space-y-space-xs pt-0.5\">\n              <span className=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold\">\n                {cat.title}\n              </span>\n              <div className=\"flex flex-wrap gap-2\">\n                {cat.items.map((item) => {\n                  const isSelected = selectedSoftwares.includes(item);\n                  return (\n                    <button\n                      key={item}\n                      className={`software-pill px-3 py-1.5 rounded-full font-label-md text-label-md flex items-center gap-1.5 transition-all cursor-pointer ${\n                        isSelected\n                          ? \'bg-primary-container text-on-primary shadow-sm font-semibold\'\n                          : \'bg-surface-container-low text-on-surface hover:bg-surface-container\'\n                      }`}\n                      type=\"button\"\n                      onClick={() => toggleSoftware(item)}\n                    >\n                      <span\n                        className={`material-symbols-outlined text-[16px] ${\n                          isSelected ? \'text-white\' : \'text-on-surface-variant\'\n                        }`}\n                      >\n                        {isSelected ? \'check_circle\' : \'add\'}\n                      </span>\n                      {item}\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          ))}\n\n          {/* Campo de Texto Adicional */}\n          <div className=\"space-y-space-xs pt-1\">\n            <label className=\"font-label-md text-label-md text-on-surface font-semibold\" htmlFor=\"outros-softwares\">\n              Outro software ou depend\303\252ncia espec\303\255fica\n            </label>\n            <input\n              className=\"w-full h-12 px-4 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md placeholder-on-surface-variant/60 focus:outline-none focus:bg-surface-container-high transition-colors\"\n              id=\"outros-softwares\"\n              placeholder=\"ex: bibliotecas pip, Node v18, Docker compose\"\n              type=\"text\"\n              value={customSoftware}\n              onChange={(e) => setCustomSoftware(e.target.value)}\n            />\n          </div>\n        </section>\n\n        {/* CTA de A\303\247\303\243o Prim\303\241ria */}\n        <section className=\"pt-2\">\n          <button\n            className=\"w-full h-14 bg-primary-container hover:bg-primary text-on-primary rounded-xl font-title-md text-title-md shadow-md flex items-center justify-center gap-2 active:scale-[0.99] transition-all cursor-pointer font-bold\"\n            type=\"button\"\n            onClick={handleProceedToStep2}\n          >\n            <span>Buscar Laborat\303\263rios Dispon\303\255veis</span>\n            <span className=\"bg-primary text-on-primary font-label-sm text-label-sm px-2 py-0.5 rounded-full\">\n              (4 compat\303\255veis)\n            </span>\n            <span className=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n          </button>\n          <p className=\"text-center font-label-sm text-label-sm text-on-surface-variant mt-2\">\n            Disponibilidade conferida em tempo real com o DTI\n          </p>\n        </section>\n      </div>\n    );\n  }\n\n  // ==========================================\n  // RENDER STEP 2: ESCOLHA DA SALA\n  // Matches Image_1_952de44c.png / Image_2_8047d8e5.html\n  // ==========================================\n  if (step === 2) {\n    const lab04Selected = selectedLabId === \'lab-04\';\n    const lab01Selected = selectedLabId === \'lab-01\';\n    const lab05Selected = selectedLabId === \'lab-05\';\n\n    const getSelectedTitle = () => {\n      if (lab04Selected) return \'Laborat\303\263rio 04 - Desenvolvimento\';\n      if (lab01Selected) return \'Laborat\303\263rio 01 (Com solicita\303\247\303\243o TI)\';\n      if (lab05Selected) return \'Laborat\303\263rio 05 - IA & GPU\';\n      return \'Laborat\303\263rio 04 - Desenvolvimento\';\n    };\n\n    return (\n      <div className=\"flex flex-col w-full pb-24\">\n        {/* Stepper Header */}\n        <div className=\"px-gutter pt-space-xs pb-space-xs flex flex-col gap-space-sm\">\n          {/* Applied filters bar */}\n          <div className=\"bg-surface-container-lowest rounded-xl p-space-sm shadow-sm flex items-center justify-between border border-outline-variant/20\">\n            <div className=\"flex items-center gap-space-xs min-w-0\">\n              <div className=\"w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary shrink-0\">\n                <span className=\"material-symbols-outlined text-[18px]\">tune</span>\n              </div>\n              <div className=\"flex flex-col min-w-0\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant truncate\">\n                  Filtros aplicados\n                </span>\n                <span className=\"font-label-md text-label-md text-on-surface font-semibold truncate\">\n                  {selectedDateObj.day} {selectedDateObj.label === \'SEX\' ? \'Out\' : \'Out\'} \342\200\242 {startTime} - {endTime} \342\200\242 {studentsCount} Alunos\n                </span>\n              </div>\n            </div>\n            <button\n              className=\"px-space-sm py-1.5 rounded-lg bg-surface-container text-primary font-label-sm text-label-sm font-semibold active:scale-95 transition-all shrink-0 cursor-pointer hover:bg-surface-container-high\"\n              type=\"button\"\n              onClick={() => setStep(1)}\n            >\n              Editar\n            </button>\n          </div>\n\n          {/* Availability Status Banner */}\n          <div className=\"bg-surface-container-high rounded-xl p-space-sm shadow-sm flex items-center gap-space-sm\">\n            <div className=\"w-9 h-9 rounded-full bg-secondary text-on-secondary flex items-center justify-center shrink-0\">\n              <span className=\"material-symbols-outlined text-[20px]\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>\n                verified\n              </span>\n            </div>\n            <div className=\"flex flex-col\">\n              <span className=\"font-label-md text-label-md text-on-surface font-semibold\">\n                4 laborat\303\263rios encontrados\n              </span>\n              <span className=\"font-body-sm text-body-sm text-on-surface-variant\">\n                2 com suporte imediato e 2 com requisitos parciais\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Labs List */}\n        <div className=\"px-gutter py-space-sm flex flex-col gap-space-md\">\n          {/* Lab 1: Destaque Perfeito (Lab 04) */}\n          <article\n            className={`bg-surface-container-lowest rounded-xl p-space-md shadow-sm relative flex flex-col gap-space-sm transition-all border ${\n              lab04Selected ? \'border-primary shadow-md ring-1 ring-primary/40\' : \'border-outline-variant/20\'\n            }`}\n            id=\"lab-card-1\"\n          >\n            <div className=\"flex items-start justify-between gap-space-xs\">\n              <div className=\"flex flex-col\">\n                <div className=\"flex items-center gap-1.5 mb-1\">\n                  <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm font-bold\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-secondary\"></span>\n                    100% Compat\303\255vel\n                  </span>\n                  <span className=\"inline-flex items-center px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">\n                    Bloco B \342\200\242 2\302\272 Andar\n                  </span>\n                </div>\n                <h2 className=\"font-headline-sm text-headline-sm text-on-surface font-bold\">\n                  Laborat\303\263rio 04 - Desenvolvimento\n                </h2>\n              </div>\n              <div className=\"w-10 h-10 rounded-full bg-surface-container-low flex items-center justify-center text-primary shrink-0\">\n                <span className=\"material-symbols-outlined text-[24px]\">terminal</span>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-space-xs py-space-xs\">\n              <div className=\"bg-surface-container-low rounded-lg p-space-sm flex flex-col justify-center\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant\">Lota\303\247\303\243o</span>\n                <span className=\"font-title-md text-title-md text-on-surface font-semibold\">40 Computadores</span>\n                <span className=\"font-body-sm text-body-sm text-on-surface-variant\">\n                  Sobra de {Math.max(0, 40 - studentsCount)} esta\303\247\303\265es\n                </span>\n              </div>\n              <div className=\"bg-surface-container-low rounded-lg p-space-sm flex flex-col justify-center\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant\">Hardware</span>\n                <span className=\"font-title-md text-title-md text-on-surface font-semibold\">Intel Core i7</span>\n                <span className=\"font-body-sm text-body-sm text-on-surface-variant\">16GB RAM \342\200\242 SSD 512GB</span>\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-1.5\">\n              <span className=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold\">\n                Softwares Instalados\n              </span>\n              <div className=\"flex flex-wrap gap-1.5\">\n                <span className=\"px-2.5 py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm font-semibold flex items-center gap-1\">\n                  <span className=\"material-symbols-outlined text-[14px]\">check</span> Android Studio\n                </span>\n                <span className=\"px-2.5 py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm font-semibold flex items-center gap-1\">\n                  <span className=\"material-symbols-outlined text-[14px]\">check</span> VS Code\n                </span>\n                <span className=\"px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">\n                  PostgreSQL\n                </span>\n                <span className=\"px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">\n                  Git\n                </span>\n              </div>\n            </div>\n\n            <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-on-surface-variant pt-space-xs\">\n              <span className=\"font-body-sm text-body-sm flex items-center gap-1\">\n                <span className=\"material-symbols-outlined text-[16px]\">ac_unit</span> Ar Condicionado\n              </span>\n              <span className=\"font-body-sm text-body-sm flex items-center gap-1\">\n                <span className=\"material-symbols-outlined text-[16px]\">videocam</span> Projetor 4K\n              </span>\n              <span className=\"font-body-sm text-body-sm flex items-center gap-1\">\n                <span className=\"material-symbols-outlined text-[16px]\">draw</span> Quadro Branco\n              </span>\n              <span className=\"font-body-sm text-body-sm flex items-center gap-1\">\n                <span className=\"material-symbols-outlined text-[16px]\">bolt</span> Nobreak Central\n              </span>\n            </div>\n\n            <div className=\"bg-surface-container-low rounded-lg p-space-sm flex items-center justify-between mt-1\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-secondary text-[20px]\">event_available</span>\n                <span className=\"font-body-sm text-body-sm text-on-surface\">\n                  Dispon\303\255vel: <strong>13:30 \303\240s 18:00</strong>\n                </span>\n              </div>\n              <span className=\"font-label-sm text-label-sm text-secondary font-bold\">Janela ideal</span>\n            </div>\n\n            <button\n              className={`w-full mt-2 h-12 rounded-lg font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 shadow-sm active:scale-[0.98] transition-all cursor-pointer ${\n                lab04Selected\n                  ? \'bg-primary-container text-on-primary shadow-md\'\n                  : \'bg-surface-container text-on-surface hover:bg-surface-container-high\'\n              }`}\n              id=\"btn-select-1\"\n              onClick={() => {\n                setSelectedLabId(\'lab-04\');\n                setRequiresITSetup(false);\n              }}\n              type=\"button\"\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">\n                {lab04Selected ? \'radio_button_checked\' : \'radio_button_unchecked\'}\n              </span>\n              <span>\n                {lab04Selected ? \'Selecionar este Laborat\303\263rio\' : \'Trocar para este Laborat\303\263rio\'}\n              </span>\n            </button>\n          </article>\n\n          {/* Lab 2: Requer A\303\247\303\243o TI (Lab 01) */}\n          <article\n            className={`bg-surface-container-lowest rounded-xl p-space-md shadow-sm relative flex flex-col gap-space-sm transition-all border ${\n              lab01Selected ? \'border-primary shadow-md ring-1 ring-primary/40\' : \'border-outline-variant/20\'\n            }`}\n            id=\"lab-card-2\"\n          >\n            <div className=\"flex items-start justify-between gap-space-xs\">\n              <div className=\"flex flex-col\">\n                <div className=\"flex items-center gap-1.5 mb-1\">\n                  <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-label-sm text-label-sm font-bold\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-tertiary\"></span>\n                    Ajuste de Software Necess\303\241rio\n                  </span>\n                  <span className=\"inline-flex items-center px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">\n                    Bloco A \342\200\242 1\302\272 Andar\n                  </span>\n                </div>\n                <h2 className=\"font-headline-sm text-headline-sm text-on-surface font-bold\">\n                  Laborat\303\263rio 01 - Inform\303\241tica Geral\n                </h2>\n              </div>\n              <div className=\"w-10 h-10 rounded-full bg-surface-container-low flex items-center justify-center text-on-surface-variant shrink-0\">\n                <span className=\"material-symbols-outlined text-[24px]\">devices</span>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-space-xs py-space-xs\">\n              <div className=\"bg-surface-container-low rounded-lg p-space-sm flex flex-col justify-center\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant\">Lota\303\247\303\243o</span>\n                <span className=\"font-title-md text-title-md text-on-surface font-semibold\">35 Computadores</span>\n                <span className=\"font-body-sm text-body-sm text-on-surface-variant\">\n                  Sobra de {Math.max(0, 35 - studentsCount)} esta\303\247\303\265es\n                </span>\n              </div>\n              <div className=\"bg-surface-container-low rounded-lg p-space-sm flex flex-col justify-center\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant\">Hardware</span>\n                <span className=\"font-title-md text-title-md text-on-surface font-semibold\">Intel Core i5</span>\n                <span className=\"font-body-sm text-body-sm text-on-surface-variant\">16GB RAM \342\200\242 SSD 256GB</span>\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-1.5\">\n              <span className=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold\">\n                Status de Software\n              </span>\n              <div className=\"flex flex-wrap gap-1.5 items-center\">\n                <span className=\"px-2.5 py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm font-semibold flex items-center gap-1\">\n                  <span className=\"material-symbols-outlined text-[14px]\">check</span> VS Code instalado\n                </span>\n                <div className=\"p-2 rounded-lg bg-surface-container-high w-full flex items-start gap-2 mt-1\">\n                  <span className=\"material-symbols-outlined text-tertiary text-[18px] shrink-0 mt-0.5\">\n                    warning\n                  </span>\n                  <div className=\"flex flex-col\">\n                    <span className=\"font-label-sm text-label-sm text-on-surface font-semibold\">\n                      Android Studio requer instala\303\247\303\243o\n                    </span>\n                    <span className=\"font-body-sm text-body-sm text-on-surface-variant\">\n                      Tempo estimado pelo suporte t\303\251cnico de TI: ~2 horas\n                    </span>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-on-surface-variant pt-space-xs\">\n              <span className=\"font-body-sm text-body-sm flex items-center gap-1\">\n                <span className=\"material-symbols-outlined text-[16px]\">ac_unit</span> Ar Condicionado\n              </span>\n              <span className=\"font-body-sm text-body-sm flex items-center gap-1\">\n                <span className=\"material-symbols-outlined text-[16px]\">videocam</span> Projetor FullHD\n              </span>\n            </div>\n\n            <button\n              className={`w-full mt-2 h-12 rounded-lg font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 active:scale-[0.98] transition-all cursor-pointer ${\n                lab01Selected\n                  ? \'bg-primary-container text-on-primary shadow-md\'\n                  : \'bg-surface-container text-on-surface hover:bg-surface-container-high\'\n              }`}\n              id=\"btn-select-2\"\n              onClick={() => {\n                setSelectedLabId(\'lab-01\');\n                setRequiresITSetup(true);\n              }}\n              type=\"button\"\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">\n                {lab01Selected ? \'radio_button_checked\' : \'handyman\'}\n              </span>\n              <span>\n                {lab01Selected ? \'Selecionado (Requer TI)\' : \'Solicitar com Instala\303\247\303\243o Pr\303\251via\'}\n              </span>\n            </button>\n          </article>\n\n          {/* Lab 3: Incompat\303\255vel Capacidade (Lab Mac 02) */}\n          <article\n            className=\"bg-surface-container-lowest/70 rounded-xl p-space-md shadow-sm relative flex flex-col gap-space-sm opacity-80 border border-outline-variant/20\"\n            id=\"lab-card-3\"\n          >\n            <div className=\"flex items-start justify-between gap-space-xs\">\n              <div className=\"flex flex-col\">\n                <div className=\"flex items-center gap-1.5 mb-1\">\n                  <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm font-semibold\">\n                    <span className=\"material-symbols-outlined text-[12px]\">block</span>\n                    Capacidade insuficiente (30/{studentsCount})\n                  </span>\n                </div>\n                <h2 className=\"font-headline-sm text-headline-sm text-on-surface font-semibold\">\n                  Laborat\303\263rio Mac 02 - Design & Apple\n                </h2>\n              </div>\n              <div className=\"w-10 h-10 rounded-full bg-surface-container-low flex items-center justify-center text-outline shrink-0\">\n                <span className=\"material-symbols-outlined text-[24px]\">desktop_mac</span>\n              </div>\n            </div>\n\n            <div className=\"bg-surface-container-low/70 rounded-lg p-space-sm flex items-center justify-between\">\n              <div className=\"flex flex-col\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant\">Lota\303\247\303\243o M\303\241xima</span>\n                <span className=\"font-title-md text-title-md text-outline font-semibold\">30 Computadores iMac</span>\n              </div>\n              <span className=\"font-body-sm text-body-sm text-error font-medium\">\n                Faltam {Math.max(0, studentsCount - 30)} assentos\n              </span>\n            </div>\n\n            <div className=\"flex flex-wrap gap-1.5\">\n              <span className=\"px-2.5 py-1 rounded-full bg-surface-container text-outline font-label-sm text-label-sm\">\n                VS Code\n              </span>\n              <span className=\"px-2.5 py-1 rounded-full bg-surface-container text-outline font-label-sm text-label-sm\">\n                Android Studio\n              </span>\n              <span className=\"px-2.5 py-1 rounded-full bg-surface-container text-outline font-label-sm text-label-sm\">\n                Xcode\n              </span>\n            </div>\n\n            <button\n              className=\"w-full mt-2 h-12 rounded-lg bg-surface-container-high text-outline font-label-lg text-label-lg font-medium flex items-center justify-center gap-2 cursor-not-allowed opacity-75\"\n              disabled\n              type=\"button\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">lock</span>\n              Indispon\303\255vel para esta turma\n            </button>\n          </article>\n        </div>\n\n        {/* Barra de Conclus\303\243o / Bottom Sticky Sheet */}\n        <div className=\"px-gutter pt-space-sm pb-space-lg flex flex-col gap-space-xs\">\n          <div className=\"bg-surface-container rounded-xl p-space-sm flex items-center justify-between\">\n            <div className=\"flex items-center gap-space-xs\">\n              <span className=\"material-symbols-outlined text-primary text-[22px]\">check_circle</span>\n              <div className=\"flex flex-col\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant\">Laborat\303\263rio Selecionado</span>\n                <span className=\"font-label-md text-label-md text-on-surface font-semibold\" id=\"selected-lab-title\">\n                  {getSelectedTitle()}\n                </span>\n              </div>\n            </div>\n            <span className={`px-2 py-1 rounded font-label-sm text-label-sm font-semibold ${\n              requiresITSetup\n                ? \'bg-tertiary-fixed text-on-tertiary-fixed-variant\'\n                : \'bg-secondary-container text-on-secondary-container\'\n            }`}>\n              {requiresITSetup ? \'Requer TI\' : \'Pronto\'}\n            </span>\n          </div>\n\n          <button\n            className=\"w-full h-12 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 shadow-md active:scale-[0.98] transition-all cursor-pointer\"\n            type=\"button\"\n            onClick={handleConfirmReservation}\n          >\n            <span>Avan\303\247ar para Revis\303\243o</span>\n            <span className=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n          </button>\n        </div>\n      </div>\n    );\n  }\n\n  // ==========================================\n  // RENDER STEP 3: COMPROVANTE DE RESERVA\n  // Matches Image_7_6dfb04e6.png / Image_8_65ad3fa0.html\n  // ==========================================\n  const ticket = confirmedReservation;\n\n  return (\n    <div className=\"flex flex-col w-full pb-safe\">\n      <div className=\"px-margin pt-space-md pb-space-lg flex flex-col items-center text-center\">\n        {/* Animated Success Badge */}\n        <div className=\"relative flex items-center justify-center w-20 h-20 mb-space-md\">\n          <div className=\"absolute inset-0 rounded-full bg-secondary-container/50 animate-ping opacity-75\"></div>\n          <div className=\"relative w-20 h-20 rounded-full bg-secondary-container flex items-center justify-center shadow-md\">\n            <span\n              className=\"material-symbols-outlined text-[44px] text-on-secondary-container\"\n              style={{ fontVariationSettings: \"\'FILL\' 1, \'wght\' 700\" }}\n            >\n              check_circle\n            </span>\n          </div>\n        </div>\n\n        {/* Title & Subtitle */}\n        <h2 className=\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-xs font-bold\">\n          Reserva Confirmada!\n        </h2>\n        <p className=\"font-body-md text-body-md text-on-surface-variant max-w-xs\">\n          Sua aloca\303\247\303\243o de laborat\303\263rio foi processada e aprovada pelo departamento acad\303\252mico.\n        </p>\n\n        {/* Protocol Snippet */}\n        <div className=\"mt-space-md inline-flex items-center gap-space-sm bg-surface-container-high px-space-md py-space-xs rounded-full\">\n          <span className=\"font-label-md text-label-md text-on-surface-variant font-medium\">Protocolo:</span>\n          <span className=\"font-title-md text-title-md text-primary font-bold tracking-wide\" id=\"protocol-code\">\n            {ticket?.protocol || \'#LR-2023-8941\'}\n          </span>\n          <button\n            aria-label=\"Copiar c\303\263digo de protocolo\"\n            className=\"flex items-center justify-center w-8 h-8 rounded-full bg-surface-container hover:bg-surface-variant transition-colors active:scale-95 text-primary cursor-pointer\"\n            id=\"copy-btn\"\n            onClick={handleCopyProtocol}\n            type=\"button\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\" id=\"copy-icon\">\n              content_copy\n            </span>\n          </button>\n        </div>\n      </div>\n\n      <div className=\"px-margin flex flex-col gap-space-lg mb-space-xl\">\n        {/* Stylized Boarding Pass / Ticket */}\n        <div className=\"relative bg-surface-container-lowest rounded-xl shadow-md overflow-hidden border border-outline-variant/30\">\n          {/* Laboratory Spotlight Header */}\n          <div className=\"relative h-28 w-full overflow-hidden\">\n            <img\n              alt=\"High tech computer lab\"\n              className=\"w-full h-full object-cover\"\n              src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBD2Co1JjGyCh6mgvhBjn8ujEzM6E_2gmAKxWNF4vFNpNflc3hRGBtuHlp6FbWCuWGusIDoi2WTw-Uy8RKT4xZZ1SJVo4nsuY09dWNaNcSsC2WKncGkVZKiRYjBwP3v2ge_fNBmKLEXdes00u6CI_bcSojYsswdCSuzz4yW7T0OEDslcF_XYbLoY_SVE6-n2L5dnIbzBYYIHDBrOHlQlrsHuRexPyZ9srXBasdMDaM22MmtvI9Zj9t2tQ\"\n              onError={(e) => {\n                const target = e.currentTarget;\n                target.src = \'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=800&q=80\';\n              }}\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/40 to-transparent\"></div>\n            <div className=\"absolute top-space-sm left-space-md bg-surface/90 backdrop-blur-md px-space-sm py-0.5 rounded-full flex items-center gap-1 shadow-sm\">\n              <span className=\"w-2 h-2 rounded-full bg-secondary animate-pulse\"></span>\n              <span className=\"font-label-sm text-label-sm text-secondary font-bold\">Sala Autenticada</span>\n            </div>\n          </div>\n\n          {/* Ticket Body Content */}\n          <div className=\"px-space-md pt-space-xs pb-space-md flex flex-col gap-space-md\">\n            <div>\n              <span className=\"font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-bold\">\n                Disciplina & Curso\n              </span>\n              <h3 className=\"font-headline-sm text-headline-sm text-on-surface mt-0.5 font-bold\">\n                {ticket?.subject || \'Desenvolvimento Web & Mobile\'}\n              </h3>\n              <p className=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5\">\n                <span className=\"material-symbols-outlined text-[16px] text-outline\">school</span>\n                {ticket?.professorName || \'Prof. Dr. Andr\303\251 Silva\'} (SIAPE: {ticket?.siape || \'198421\'})\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-space-sm bg-surface-container-low p-space-sm rounded-lg\">\n              <div className=\"flex flex-col\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant font-medium\">Laborat\303\263rio</span>\n                <span className=\"font-title-md text-title-md text-on-surface font-bold\">\n                  {ticket?.labName.split(\'-\')[0]?.trim() || \'Lab 04\'}\n                </span>\n                <span className=\"font-body-sm text-body-sm text-on-surface-variant\">{ticket?.location || \'Bloco B, Sala 204\'}</span>\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant font-medium\">Capacidade / Lota\303\247\303\243o</span>\n                <span className=\"font-title-md text-title-md text-on-surface font-bold\">\n                  {ticket?.studentsCount || 32} Alunos\n                </span>\n                <span className=\"font-body-sm text-body-sm text-on-surface-variant\">\n                  Total: {ticket?.totalStations || 40} Esta\303\247\303\265es\n                </span>\n              </div>\n            </div>\n\n            <div className=\"flex items-start gap-space-sm\">\n              <div className=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center shrink-0 text-primary\">\n                <span className=\"material-symbols-outlined text-[20px]\">calendar_today</span>\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"font-title-md text-title-md text-on-surface font-semibold\">\n                  {ticket?.dateFormatted || \'Sexta-feira, 27 de Outubro\'}\n                </span>\n                <span className=\"font-body-sm text-body-sm text-on-surface-variant font-medium\">\n                  {ticket?.startTime || \'14:00\'} \303\240s {ticket?.endTime || \'17:30\'} (Dura\303\247\303\243o: {ticket?.durationStr || \'3h30min\'})\n                </span>\n              </div>\n            </div>\n\n            <div>\n              <span className=\"font-label-sm text-label-sm text-on-surface-variant block mb-1 font-semibold\">\n                Ambiente de Software Preparado\n              </span>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {(ticket?.requiredSoftware && ticket.requiredSoftware.length > 0\n                  ? ticket.requiredSoftware\n                  : [\'Android Studio 2023.2\', \'VS Code\', \'PostgreSQL 15\']\n                ).map((soft, idx) => (\n                  <span\n                    key={idx}\n                    className={`font-label-sm text-label-sm px-2.5 py-1 rounded-full font-semibold flex items-center gap-1 ${\n                      idx === 0\n                        ? \'bg-primary-fixed text-on-primary-fixed\'\n                        : \'bg-surface-container-high text-on-surface-variant\'\n                    }`}\n                  >\n                    {idx === 0 && <span className=\"material-symbols-outlined text-[14px]\">terminal</span>}\n                    {soft}\n                  </span>\n                ))}\n              </div>\n            </div>\n          </div>\n\n          {/* Ticket Perforated Divider with Cutout Circles */}\n          <div className=\"relative w-full h-8 flex items-center justify-between overflow-hidden\">\n            <div className=\"w-4 h-8 bg-surface rounded-r-full -ml-0.5 shadow-inner\"></div>\n            <div className=\"flex-1 border-t-2 border-dashed border-outline-variant mx-2 opacity-60\"></div>\n            <div className=\"w-4 h-8 bg-surface rounded-l-full -mr-0.5 shadow-inner\"></div>\n          </div>\n\n          {/* Ticket Bottom: QR Code Digital Access Key */}\n          <div className=\"px-space-md pt-space-xs pb-space-lg flex flex-col items-center text-center\">\n            <div className=\"p-3 bg-surface-container-lowest rounded-xl shadow-sm mb-space-sm flex flex-col items-center\">\n              {/* Stylized High-Fidelity SVG QR Representation */}\n              <svg className=\"w-36 h-36\" fill=\"none\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\">\n                <rect fill=\"#FFFFFF\" height=\"100\" rx=\"8\" width=\"100\"></rect>\n                {/* Top Left Finder Pattern */}\n                <rect fill=\"#131B2E\" height=\"24\" rx=\"4\" width=\"24\" x=\"8\" y=\"8\"></rect>\n                <rect fill=\"#FFFFFF\" height=\"16\" rx=\"2\" width=\"16\" x=\"12\" y=\"12\"></rect>\n                <rect fill=\"#0037B0\" height=\"8\" rx=\"1.5\" width=\"8\" x=\"16\" y=\"16\"></rect>\n                {/* Top Right Finder Pattern */}\n                <rect fill=\"#131B2E\" height=\"24\" rx=\"4\" width=\"24\" x=\"68\" y=\"8\"></rect>\n                <rect fill=\"#FFFFFF\" height=\"16\" rx=\"2\" width=\"16\" x=\"72\" y=\"12\"></rect>\n                <rect fill=\"#0037B0\" height=\"8\" rx=\"1.5\" width=\"8\" x=\"76\" y=\"16\"></rect>\n                {/* Bottom Left Finder Pattern */}\n                <rect fill=\"#131B2E\" height=\"24\" rx=\"4\" width=\"24\" x=\"8\" y=\"68\"></rect>\n                <rect fill=\"#FFFFFF\" height=\"16\" rx=\"2\" width=\"16\" x=\"12\" y=\"72\"></rect>\n                <rect fill=\"#0037B0\" height=\"8\" rx=\"1.5\" width=\"8\" x=\"16\" y=\"76\"></rect>\n                {/* Stylized Data Matrix Dots */}\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"36\" y=\"10\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"46\" y=\"10\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"56\" y=\"14\"></rect>\n                <rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"36\" y=\"20\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"46\" y=\"24\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"10\" y=\"36\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"20\" y=\"38\"></rect>\n                <rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"10\" y=\"48\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"20\" y=\"56\"></rect>\n                <rect fill=\"#0037B0\" height=\"8\" rx=\"2\" width=\"8\" x=\"36\" y=\"36\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"48\" y=\"36\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"58\" y=\"38\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"70\" y=\"36\"></rect>\n                <rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"82\" y=\"38\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"36\" y=\"48\"></rect>\n                <rect fill=\"#131B2E\" height=\"8\" rx=\"2\" width=\"8\" x=\"46\" y=\"48\"></rect>\n                <rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"58\" y=\"48\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"76\" y=\"48\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"36\" y=\"60\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"46\" y=\"60\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"56\" y=\"62\"></rect>\n                <rect fill=\"#131B2E\" height=\"8\" rx=\"2\" width=\"8\" x=\"68\" y=\"60\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"80\" y=\"62\"></rect>\n                <rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"36\" y=\"74\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"48\" y=\"72\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"58\" y=\"76\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"70\" y=\"74\"></rect>\n                <rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"82\" y=\"76\"></rect>\n                <rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"40\" y=\"84\"></rect>\n                <rect fill=\"#0037B0\" height=\"8\" rx=\"2\" width=\"8\" x=\"52\" y=\"84\"></rect>\n                <rect fill=\"#131B2E\
  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState, useEffect } from \'react\';\nimport { Header } from \'./components/Header\';\nimport { BottomNav, NavTab } from \'./components/BottomNav\';\nimport { HomeScreen } from \'./components/HomeScreen\';\nimport { ReservationWizard } from \'./components/ReservationWizard\';\nimport { LabsDirectoryScreen } from \'./components/LabsDirectoryScreen\';\nimport { HistoryScreen } from \'./components/HistoryScreen\';\nimport { QrAccessModal } from \'./components/QrAccessModal\';\nimport { SoftwareRequestModal } from \'./components/SoftwareRequestModal\';\nimport { NotificationsDrawer } from \'./components/NotificationsDrawer\';\nimport { ProfileModal } from \'./components/ProfileModal\';\nimport {\n  INITIAL_LABS,\n  INITIAL_RESERVATIONS,\n  INITIAL_NOTIFICATIONS,\n} from \'./data/mockData\';\nimport { Lab, Reservation, NotificationItem } from \'./types\';\n\nexport default function App() {\n  const [currentTab, setCurrentTab] = useState<NavTab>(\'inicio\');\n\n  // Persistence with localStorage\n  const [labs, setLabs] = useState<Lab[]>(() => {\n    const saved = localStorage.getItem(\'labreserve_labs\');\n    return saved ? JSON.parse(saved) : INITIAL_LABS;\n  });\n\n  const [reservations, setReservations] = useState<Reservation[]>(() => {\n    const saved = localStorage.getItem(\'labreserve_reservations\');\n    return saved ? JSON.parse(saved) : INITIAL_RESERVATIONS;\n  });\n\n  const [notifications, setNotifications] = useState<NotificationItem[]>(() => {\n    const saved = localStorage.getItem(\'labreserve_notifications\');\n    return saved ? JSON.parse(saved) : INITIAL_NOTIFICATIONS;\n  });\n\n  // Modals & Drawers state\n  const [qrModalReservation, setQrModalReservation] = useState<Reservation | null>(null);\n  const [softwareRequestModalOpen, setSoftwareRequestModalOpen] = useState(false);\n  const [profileModalOpen, setProfileModalOpen] = useState(false);\n  const [notificationsDrawerOpen, setNotificationsDrawerOpen] = useState(false);\n\n  // Deep view state for Reservation Wizard\n  const [viewingTicketReservation, setViewingTicketReservation] = useState<Reservation | null>(null);\n  const [initialLabForWizard, setInitialLabForWizard] = useState<string | null>(null);\n\n  // Sync to localStorage\n  useEffect(() => {\n    localStorage.setItem(\'labreserve_reservations\', JSON.stringify(reservations));\n  }, [reservations]);\n\n  useEffect(() => {\n    localStorage.setItem(\'labreserve_labs\', JSON.stringify(labs));\n  }, [labs]);\n\n  useEffect(() => {\n    localStorage.setItem(\'labreserve_notifications\', JSON.stringify(notifications));\n  }, [notifications]);\n\n  // Handlers\n  const handleAddNewReservation = (newRes: Reservation) => {\n    setReservations((prev) => [newRes, ...prev]);\n\n    // Add a notification for this booking\n    const newNotif: NotificationItem = {\n      id: `notif-${Date.now()}`,\n      title: `Reserva confirmada: ${newRes.labName}`,\n      description: `Aloca\303\247\303\243o gerada para ${newRes.subject} no dia ${newRes.dateFormatted}. Protocolo ${newRes.protocol}.`,\n      timestamp: \'Agora mesmo\',\n      read: false,\n      type: \'success\',\n    };\n    setNotifications((prev) => [newNotif, ...prev]);\n  };\n\n  const handleCancelReservation = (resId: string) => {\n    setReservations((prev) => prev.filter((r) => r.id !== resId));\n    const cancelNotif: NotificationItem = {\n      id: `notif-${Date.now()}`,\n      title: \'Reserva cancelada com sucesso\',\n      description: \'A sala e as esta\303\247\303\265es foram liberadas no sistema para outros professores.\',\n      timestamp: \'Agora mesmo\',\n      read: false,\n      type: \'info\',\n    };\n    setNotifications((prev) => [cancelNotif, ...prev]);\n  };\n\n  const handleSoftwareRequestSubmitted = (data: { labId: string; softwareName: string; justification: string }) => {\n    const targetLab = labs.find((l) => l.id === data.labId);\n    const labName = targetLab ? targetLab.name : \'Laborat\303\263rio\';\n\n    const newNotif: NotificationItem = {\n      id: `notif-${Date.now()}`,\n      title: `Chamado DTI aberto para ${labName}`,\n      description: `Instala\303\247\303\243o do pacote ${data.softwareName} solicitada. Previs\303\243o de atendimento em ~2 horas.`,\n      timestamp: \'Agora mesmo\',\n      read: false,\n      type: \'warning\',\n    };\n    setNotifications((prev) => [newNotif, ...prev]);\n  };\n\n  const handleSelectLabForReservation = (lab: Lab) => {\n    setInitialLabForWizard(lab.id);\n    setViewingTicketReservation(null);\n    setCurrentTab(\'nova-reserva\');\n  };\n\n  const handleViewTicketFromAnywhere = (res: Reservation) => {\n    setViewingTicketReservation(res);\n    setCurrentTab(\'nova-reserva\');\n  };\n\n  const handleBack = () => {\n    if (viewingTicketReservation) {\n      setViewingTicketReservation(null);\n      setCurrentTab(\'inicio\');\n    } else if (currentTab !== \'inicio\') {\n      setCurrentTab(\'inicio\');\n    }\n  };\n\n  // Header Subtitle Text\n  const getHeaderSubtitle = () => {\n    if (viewingTicketReservation) return \'Comprovante De Reserva\';\n    switch (currentTab) {\n      case \'inicio\':\n        return \'In\303\255cio\';\n      case \'nova-reserva\':\n        return \'Nova Reserva\';\n      case \'laboratorios\':\n        return \'Laborat\303\263rios\';\n      case \'historico\':\n        return \'Hist\303\263rico\';\n      default:\n        return \'Laborat\303\263rios\';\n    }\n  };\n\n  const unreadCount = notifications.filter((n) => !n.read).length;\n\n  return (\n    <div className=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen selection:bg-primary-container selection:text-white\">\n      {/* Fixed Header */}\n      <Header\n        subtitle={getHeaderSubtitle()}\n        showBack={currentTab !== \'inicio\' || viewingTicketReservation !== null}\n        onBack={handleBack}\n        onOpenNotifications={() => setNotificationsDrawerOpen(true)}\n        onOpenProfile={() => setProfileModalOpen(true)}\n        unreadCount={unreadCount}\n      />\n\n      {/* Main Content Body */}\n      <main className=\"flex-1 flex flex-col relative w-full pt-16 bg-surface max-w-xl mx-auto min-h-screen\">\n        {currentTab === \'inicio\' && (\n          <HomeScreen\n            reservations={reservations}\n            onStartReservation={() => {\n              setViewingTicketReservation(null);\n              setInitialLabForWizard(null);\n              setCurrentTab(\'nova-reserva\');\n            }}\n            onViewLabs={() => setCurrentTab(\'laboratorios\')}\n            onOpenSoftwareRequest={() => setSoftwareRequestModalOpen(true)}\n            onOpenQrModal={(res) => setQrModalReservation(res)}\n            onViewReservationTicket={handleViewTicketFromAnywhere}\n            onViewAllHistory={() => setCurrentTab(\'historico\')}\n          />\n        )}\n\n        {currentTab === \'nova-reserva\' && (\n          <ReservationWizard\n            key={viewingTicketReservation ? viewingTicketReservation.id : \'wizard-active\'}\n            labs={labs}\n            initialLabId={initialLabForWizard}\n            activeReservationForTicket={viewingTicketReservation}\n            onFinishReservation={(newRes) => {\n              handleAddNewReservation(newRes);\n            }}\n            onCancel={() => {\n              setViewingTicketReservation(null);\n              setCurrentTab(\'inicio\');\n            }}\n          />\n        )}\n\n        {currentTab === \'laboratorios\' && (\n          <LabsDirectoryScreen\n            labs={labs}\n            onSelectLabForReservation={handleSelectLabForReservation}\n            onRequestSoftwareForLab={() => setSoftwareRequestModalOpen(true)}\n          />\n        )}\n\n        {currentTab === \'historico\' && (\n          <HistoryScreen\n            reservations={reservations}\n            onViewTicket={handleViewTicketFromAnywhere}\n            onOpenQrModal={(res) => setQrModalReservation(res)}\n            onCancelReservation={handleCancelReservation}\n            onStartNewReservation={() => {\n              setViewingTicketReservation(null);\n              setInitialLabForWizard(null);\n              setCurrentTab(\'nova-reserva\');\n            }}\n          />\n        )}\n      </main>\n\n      {/* Fixed Bottom Navigation */}\n      <BottomNav\n        currentTab={currentTab}\n        onSelectTab={(tab) => {\n          setViewingTicketReservation(null);\n          setCurrentTab(tab);\n          window.scrollTo({ top: 0, behavior: \'smooth\' });\n        }}\n      />\n\n      {/* Auxiliary Modals & Drawers */}\n      <QrAccessModal\n        isOpen={qrModalReservation !== null}\n        onClose={() => setQrModalReservation(null)}\n        reservation={qrModalReservation}\n      />\n\n      <SoftwareRequestModal\n        isOpen={softwareRequestModalOpen}\n        onClose={() => setSoftwareRequestModalOpen(false)}\n        labs={labs}\n        onRequestSubmitted={handleSoftwareRequestSubmitted}\n      />\n\n      <NotificationsDrawer\n        isOpen={notificationsDrawerOpen}\n        onClose={() => setNotificationsDrawerOpen(false)}\n        notifications={notifications}\n        onMarkAllAsRead={() => {\n          setNotifications((prev) => prev.map((n) => ({ ...n, read: true })));\n        }}\n        onClearNotifications={() => setNotifications([])}\n      />\n\n      <ProfileModal\n        isOpen={profileModalOpen}\n        onClose={() => setProfileModalOpen(false)}\n        activeCount={reservations.filter((r) => r.status === \'confirmada\').length}\n      />\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/App.tsx"
        }
        overwrite: true
      }
    }

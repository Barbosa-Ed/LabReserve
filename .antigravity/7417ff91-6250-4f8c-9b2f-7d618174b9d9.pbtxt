            lines {
              text: "    const hours = Math.floor(diffMinutes / 60);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const minutes = diffMinutes % 60;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return `${hours}h${minutes > 0 ? ` ${minutes}min` : \'\'}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT

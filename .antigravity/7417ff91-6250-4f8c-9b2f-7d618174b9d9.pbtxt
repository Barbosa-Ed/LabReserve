    content: "<!DOCTYPE html>\n\n<html lang=\"pt-BR\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_tab\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"secondary-fixed-dim\": \"#4edea3\", \"secondary\": \"#006c49\", \"background\": \"#faf8ff\", \"surface-dim\": \"#d2d9f4\", \"on-tertiary-fixed-variant\": \"#653e00\", \"on-secondary-fixed-variant\": \"#005236\", \"tertiary-container\": \"#825100\", \"tertiary-fixed-dim\": \"#ffb95f\", \"on-secondary\": \"#ffffff\", \"secondary-container\": \"#6cf8bb\", \"on-background\": \"#131b2e\", \"on-tertiary\": \"#ffffff\", \"outline-variant\": \"#c4c5d7\", \"on-tertiary-fixed\": \"#2a1700\", \"on-tertiary-container\": \"#ffcb8f\", \"inverse-on-surface\": \"#eef0ff\", \"on-primary-container\": \"#cad3ff\", \"surface-bright\": \"#faf8ff\", \"on-secondary-fixed\": \"#002113\", \"secondary-fixed\": \"#6ffbbe\", \"on-surface-variant\": \"#434655\", \"on-primary-fixed-variant\": \"#0039b5\", \"primary-container\": \"#1d4ed8\", \"tertiary\": \"#623c00\", \"surface-container\": \"#eaedff\", \"surface\": \"#faf8ff\", \"on-secondary-container\": \"#00714d\", \"outline\": \"#747686\", \"surface-tint\": \"#2151da\", \"surface-container-low\": \"#f2f3ff\", \"surface-variant\": \"#dae2fd\", \"on-error\": \"#ffffff\", \"primary\": \"#0037b0\", \"on-primary\": \"#ffffff\", \"error-container\": \"#ffdad6\", \"primary-fixed-dim\": \"#b7c4ff\", \"primary-fixed\": \"#dce1ff\", \"tertiary-fixed\": \"#ffddb8\", \"surface-container-highest\": \"#dae2fd\", \"inverse-surface\": \"#283044\", \"on-primary-fixed\": \"#001551\", \"surface-container-high\": \"#e2e7ff\", \"inverse-primary\": \"#b7c4ff\", \"error\": \"#ba1a1a\", \"on-surface\": \"#131b2e\", \"on-error-container\": \"#93000a\", \"surface-container-lowest\": \"#ffffff\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"margin\": \"1rem\", \"space-md\": \"1rem\", \"space-xl\": \"2rem\", \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"space-lg\": \"1.5rem\", \"space-sm\": \"0.5rem\" }, fontFamily: { \"body-sm\": [\"Plus Jakarta Sans\"], \"display-lg\": [\"Plus Jakarta Sans\"], \"headline-md\": [\"Plus Jakarta Sans\"], \"label-md\": [\"Plus Jakarta Sans\"], \"title-md\": [\"Plus Jakarta Sans\"], \"label-lg\": [\"Plus Jakarta Sans\"], \"body-md\": [\"Plus Jakarta Sans\"], \"headline-sm\": [\"Plus Jakarta Sans\"], \"headline-lg\": [\"Plus Jakarta Sans\"], \"label-sm\": [\"Plus Jakarta Sans\"], \"body-lg\": [\"Plus Jakarta Sans\"] }, fontSize: { \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"display-lg\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }], \"headline-md\": [\"20px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"600\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"title-md\": [\"16px\", { \"lineHeight\": \"22px\", \"fontWeight\": \"600\" }], \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"headline-lg\": [\"24px\", { \"lineHeight\": \"32px\", \"letterSpacing\": \"-0.015em\", \"fontWeight\": \"700\" }], \"label-sm\": [\"11px\", { \"lineHeight\": \"14px\", \"letterSpacing\": \"0.03em\", \"fontWeight\": \"600\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }] } } } };</script><style>@layer base{html,body{width:100%;min-height:100%;margin:0;padding:0;}body{overscroll-behavior-y:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 inset-x-0 z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] pt-safe\"><div class=\"h-16 px-gutter flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><img alt=\"LabReserve Logo\" class=\"h-8 w-auto object-contain\" src=\"https://lh3.googleusercontent.com/aida/AEtjO1Xzpg_lS837oxSWCBlplqPFSe1nt2DTJ1AIdxqjatdVzRrR7i6J-ArBIpCR6ujvUTgfC9O5dPLrB8ZV1ZJYL7ctGQTOoSPZMHulQoRSa17Fv4mVDg6guuDd_z4Q1-Am2nDV7JbPb4CYe7bfR9ynMp_HVCn7f_nOCgeOPDsxkItcLA-B5UshpN73NcvRVRgyEoqgpzWF1HoK1mVzTQUgkBBPLuo0iR77yd1E9e6Y0-C7UqN-1DzRzCOViMI\"/><div class=\"flex flex-col\"><span class=\"font-headline-sm text-headline-sm text-primary leading-none\">LabReserve</span><span class=\"font-label-sm text-label-sm text-on-surface-variant leading-none mt-0.5\">Nova Reserva</span></div></div><div class=\"flex items-center gap-space-sm\"><button aria-label=\"Notifica\303\247\303\265es\" class=\"w-11 h-11 flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors\"><span class=\"material-symbols-outlined text-[24px]\">notifications</span></button><div class=\"flex items-center gap-space-xs\"><img alt=\"Profile\" class=\"w-8 h-8 rounded-full object-cover ring-2 ring-primary-fixed\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDlKNP45fFEPE8-tOAuDHEAj7iXJe0uFkM0jJkpZZktmdQxE9Q5wR09uoj-iU91RMcE6EW65ZtNxwbWhB7z9fP35KgI3U0LIZZjUGiX0E-wi2LNVMQUr5DgVmv3OLE86iR86ThM3mCcGSMvrrY_UNBoVX0wtWTuQhAqyA8Pq2pNpiMSkyaRCeY6BG5rAxxrq-yc-kcdMZmUW3LA5bhgUxSrjH75se-quNWoZIXqpZaP_mvT7D4Fs75_zg\"/></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full pt-16 pb-24 bg-surface\"><div class=\"flex flex-col w-full px-margin pb-12 space-y-space-lg\">\n<!-- Stepper de Progresso -->\n<section class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-sm\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs text-primary font-label-md\">\n<span class=\"material-symbols-outlined text-[18px]\">tune</span>\n<span>Passo 1 de 3</span>\n</div>\n<span class=\"font-label-sm text-on-surface-variant\">Par\303\242metros de Aula</span>\n</div>\n<!-- Barra de Progresso com Preenchimento Din\303\242mico -->\n<div class=\"w-full bg-surface-container-high h-2 rounded-full overflow-hidden\">\n<div class=\"bg-primary-container h-full w-1/3 rounded-full transition-all duration-300\"></div>\n</div>\n<div class=\"flex justify-between items-center text-on-surface-variant font-label-sm pt-1\">\n<span class=\"text-primary font-label-md\">1. Requisitos</span>\n<span>2. Escolha da Sala</span>\n<span>3. Confirma\303\247\303\243o</span>\n</div>\n</section>\n<!-- Contexto Acad\303\252mico: Disciplina e Turma -->\n<section class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-md\">\n<div class=\"flex items-center gap-space-sm text-primary\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">school</span>\n</div>\n<div>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Dados da Disciplina</h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Informe o plano de aula para aloca\303\247\303\243o</p>\n</div>\n</div>\n<!-- Select Disciplina -->\n<div class=\"space-y-space-xs\">\n<label class=\"font-label-md text-label-md text-on-surface\" for=\"select-disciplina\">Mat\303\251ria / Disciplina</label>\n<div class=\"relative\">\n<select class=\"w-full h-12 pl-4 pr-10 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md appearance-none focus:outline-none focus:bg-surface-container-high transition-colors\" id=\"select-disciplina\">\n<option selected=\"\" value=\"web-mobile\">Desenvolvimento Web &amp; Mobile</option>\n<option value=\"bd2\">Banco de Dados II</option>\n<option value=\"eng-soft\">Engenharia de Software</option>\n<option value=\"sist-distrib\">Sistemas Distribu\303\255dos</option>\n</select>\n<span class=\"material-symbols-outlined absolute right-3 top-3 text-on-surface-variant pointer-events-none text-[20px]\">expand_more</span>\n</div>\n</div>\n<!-- Select Turma -->\n<div class=\"space-y-space-xs\">\n<label class=\"font-label-md text-label-md text-on-surface\" for=\"select-turma\">Turma Designada</label>\n<div class=\"relative\">\n<select class=\"w-full h-12 pl-4 pr-10 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md appearance-none focus:outline-none focus:bg-surface-container-high transition-colors\" id=\"select-turma\">\n<option selected=\"\" value=\"turma-b\">Turma B - Noturno (Eng. Computa\303\247\303\243o)</option>\n<option value=\"turma-a\">Turma A - Matutino (Sistemas de Informa\303\247\303\243o)</option>\n<option value=\"turma-c\">Turma C - Vespertino (Ci\303\252ncia da Computa\303\247\303\243o)</option>\n</select>\n<span class=\"material-symbols-outlined absolute right-3 top-3 text-on-surface-variant pointer-events-none text-[20px]\">groups</span>\n</div>\n</div>\n</section>\n<!-- Lota\303\247\303\243o e Capacidade Necess\303\241ria -->\n<section class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-md\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-sm text-primary\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">person_check</span>\n</div>\n<div>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Quantidade de Alunos</h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Postos de trabalho necess\303\241rios</p>\n</div>\n</div>\n<span class=\"bg-secondary-container text-on-secondary-container font-label-sm text-label-sm px-2.5 py-1 rounded-full flex items-center gap-1\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-secondary\"></span>\n        1:1 Aluno/PC\n      </span>\n</div>\n<!-- Card Contador Din\303\242mico -->\n<div class=\"bg-surface-container-low p-space-md rounded-xl flex items-center justify-between\">\n<button aria-label=\"Diminuir alunos\" class=\"w-11 h-11 rounded-lg bg-surface-container-lowest text-on-surface flex items-center justify-center shadow-sm active:scale-95 transition-transform\" id=\"btn-decrement\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">remove</span>\n</button>\n<div class=\"flex flex-col items-center\">\n<span class=\"font-display-lg text-display-lg text-primary leading-none\" id=\"student-count-display\">32</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant mt-0.5\">esta\303\247\303\265es ativas</span>\n</div>\n<button aria-label=\"Aumentar alunos\" class=\"w-11 h-11 rounded-lg bg-surface-container-lowest text-on-surface flex items-center justify-center shadow-sm active:scale-95 transition-transform\" id=\"btn-increment\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">add</span>\n</button>\n</div>\n<!-- Slider de Ajuste Fino -->\n<div class=\"space-y-space-xs pt-1\">\n<div class=\"flex justify-between font-label-sm text-label-sm text-on-surface-variant\">\n<span>Min: 1</span>\n<span>Ajuste R\303\241pido</span>\n<span>M\303\241x: 50</span>\n</div>\n<input class=\"w-full accent-primary-container h-2 bg-surface-container rounded-lg cursor-pointer\" id=\"student-slider\" max=\"50\" min=\"1\" type=\"range\" value=\"32\"/>\n</div>\n<!-- Aviso Din\303\242mico Inteligente -->\n<div class=\"bg-surface-container-high p-space-sm rounded-lg flex items-center gap-space-sm text-on-surface\" id=\"capacity-warning\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">info</span>\n<p class=\"font-body-sm text-body-sm\" id=\"capacity-warning-text\">Recomendado labs com no m\303\255nimo <strong>35 esta\303\247\303\265es</strong> (reserva de margem).</p>\n</div>\n</section>\n<!-- Data e Hor\303\241rios de Uso -->\n<section class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-md\">\n<div class=\"flex items-center gap-space-sm text-primary\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">event</span>\n</div>\n<div>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Data e Hor\303\241rio</h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Selecione o dia e o bloco de aulas</p>\n</div>\n</div>\n<!-- Carrossel Horizontal de Datas -->\n<div class=\"space-y-space-xs\">\n<span class=\"font-label-md text-label-md text-on-surface\">Data Selecionada: <strong class=\"text-primary\" id=\"selected-date-text\">Sex, 27 de Outubro</strong></span>\n<div class=\"flex gap-2 overflow-x-auto pb-2 pt-1 -mx-2 px-2 no-scrollbar\">\n<!-- Dia 1 -->\n<button class=\"date-chip flex-shrink-0 w-16 py-2.5 rounded-xl bg-surface-container-low text-on-surface flex flex-col items-center gap-0.5 transition-all\" data-date=\"Qua, 25 de Outubro\" type=\"button\">\n<span class=\"font-label-sm text-label-sm opacity-80\">QUA</span>\n<span class=\"font-headline-sm text-headline-sm\">25</span>\n</button>\n<!-- Dia 2 -->\n<button class=\"date-chip flex-shrink-0 w-16 py-2.5 rounded-xl bg-surface-container-low text-on-surface flex flex-col items-center gap-0.5 transition-all\" data-date=\"Qui, 26 de Outubro\" type=\"button\">\n<span class=\"font-label-sm text-label-sm opacity-80\">QUI</span>\n<span class=\"font-headline-sm text-headline-sm\">26</span>\n</button>\n<!-- Dia 3 (Ativo) -->\n<button class=\"date-chip flex-shrink-0 w-16 py-2.5 rounded-xl bg-primary text-on-primary flex flex-col items-center gap-0.5 transition-all shadow-sm\" data-date=\"Sex, 27 de Outubro\" type=\"button\">\n<span class=\"font-label-sm text-label-sm opacity-90\">SEX</span>\n<span class=\"font-headline-sm text-headline-sm\">27</span>\n</button>\n<!-- Dia 4 -->\n<button class=\"date-chip flex-shrink-0 w-16 py-2.5 rounded-xl bg-surface-container-low text-on-surface flex flex-col items-center gap-0.5 transition-all\" data-date=\"Seg, 30 de Outubro\" type=\"button\">\n<span class=\"font-label-sm text-label-sm opacity-80\">SEG</span>\n<span class=\"font-headline-sm text-headline-sm\">30</span>\n</button>\n<!-- Dia 5 -->\n<button class=\"date-chip flex-shrink-0 w-16 py-2.5 rounded-xl bg-surface-container-low text-on-surface flex flex-col items-center gap-0.5 transition-all\" data-date=\"Ter, 31 de Outubro\" type=\"button\">\n<span class=\"font-label-sm text-label-sm opacity-80\">TER</span>\n<span class=\"font-headline-sm text-headline-sm\">31</span>\n</button>\n<!-- Dia 6 -->\n<button class=\"date-chip flex-shrink-0 w-16 py-2.5 rounded-xl bg-surface-container-low text-on-surface flex flex-col items-center gap-0.5 transition-all\" data-date=\"Qua, 01 de Novembro\" type=\"button\">\n<span class=\"font-label-sm text-label-sm opacity-80\">QUA</span>\n<span class=\"font-headline-sm text-headline-sm\">01</span>\n</button>\n</div>\n</div>\n<!-- Bloco de In\303\255cio e T\303\251rmino -->\n<div class=\"grid grid-cols-2 gap-space-sm pt-1\">\n<div class=\"space-y-space-xs\">\n<label class=\"font-label-md text-label-md text-on-surface\" for=\"time-start\">Hor\303\241rio In\303\255cio</label>\n<div class=\"relative\">\n<select class=\"w-full h-12 pl-3 pr-8 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md appearance-none focus:outline-none\" id=\"time-start\">\n<option value=\"13:30\">13:30</option>\n<option selected=\"\" value=\"14:00\">14:00</option>\n<option value=\"15:00\">15:00</option>\n<option value=\"18:30\">18:30</option>\n<option value=\"19:15\">19:15</option>\n</select>\n<span class=\"material-symbols-outlined absolute right-2.5 top-3 text-on-surface-variant pointer-events-none text-[18px]\">schedule</span>\n</div>\n</div>\n<div class=\"space-y-space-xs\">\n<label class=\"font-label-md text-label-md text-on-surface\" for=\"time-end\">Hor\303\241rio T\303\251rmino</label>\n<div class=\"relative\">\n<select class=\"w-full h-12 pl-3 pr-8 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md appearance-none focus:outline-none\" id=\"time-end\">\n<option value=\"16:00\">16:00</option>\n<option value=\"17:00\">17:00</option>\n<option selected=\"\" value=\"17:30\">17:30</option>\n<option value=\"21:00\">21:00</option>\n<option value=\"22:00\">22:00</option>\n</select>\n<span class=\"material-symbols-outlined absolute right-2.5 top-3 text-on-surface-variant pointer-events-none text-[18px]\">timelapse</span>\n</div>\n</div>\n</div>\n<!-- Badge Autom\303\241tico de Dura\303\247\303\243o -->\n<div class=\"flex items-center justify-between bg-surface-container-high px-space-md py-2.5 rounded-lg\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Tempo total de ocupa\303\247\303\243o</span>\n<span class=\"bg-primary-fixed text-on-primary-fixed font-label-md text-label-md px-3 py-1 rounded-full flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px]\">hourglass_top</span>\n        Dura\303\247\303\243o: 3h 30min\n      </span>\n</div>\n</section>\n<!-- Softwares Espec\303\255ficos Necess\303\241rios -->\n<section class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-md\">\n<div class=\"flex items-center gap-space-sm text-primary\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">terminal</span>\n</div>\n<div>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Softwares &amp; Ambiente</h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Filtre laborat\303\263rios com a pilha pronta</p>\n</div>\n</div>\n<!-- Categoria: IDEs & C\303\263digo -->\n<div class=\"space-y-space-xs\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">IDEs &amp; C\303\263digo</span>\n<div class=\"flex flex-wrap gap-2\">\n<button class=\"software-pill px-3 py-1.5 rounded-full font-label-md text-label-md bg-primary-container text-on-primary flex items-center gap-1.5 transition-all shadow-sm\" data-selected=\"true\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">check_circle</span>\n          VS Code\n        </button>\n<button class=\"software-pill px-3 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-low text-on-surface flex items-center gap-1.5 transition-all\" data-selected=\"false\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\">add</span>\n          IntelliJ IDEA\n        </button>\n<button class=\"software-pill px-3 py-1.5 rounded-full font-label-md text-label-md bg-primary-container text-on-primary flex items-center gap-1.5 transition-all shadow-sm\" data-selected=\"true\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">check_circle</span>\n          Android Studio\n        </button>\n<button class=\"software-pill px-3 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-low text-on-surface flex items-center gap-1.5 transition-all\" data-selected=\"false\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\">add</span>\n          Eclipse\n        </button>\n</div>\n</div>\n<!-- Categoria: Bancos & Dados -->\n<div class=\"space-y-space-xs pt-1\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Bancos &amp; Dados</span>\n<div class=\"flex flex-wrap gap-2\">\n<button class=\"software-pill px-3 py-1.5 rounded-full font-label-md text-label-md bg-primary-container text-on-primary flex items-center gap-1.5 transition-all shadow-sm\" data-selected=\"true\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">check_circle</span>\n          PostgreSQL / DBeaver\n        </button>\n<button class=\"software-pill px-3 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-low text-on-surface flex items-center gap-1.5 transition-all\" data-selected=\"false\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\">add</span>\n          MySQL Workbench\n        </button>\n<button class=\"software-pill px-3 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-low text-on-surface flex items-center gap-1.5 transition-all\" data-selected=\"false\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\">add</span>\n          MongoDB\n        </button>\n</div>\n</div>\n<!-- Categoria: Engenharia & Design -->\n<div class=\"space-y-space-xs pt-1\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Engenharia &amp; Design</span>\n<div class=\"flex flex-wrap gap-2\">\n<button class=\"software-pill px-3 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-low text-on-surface flex items-center gap-1.5 transition-all\" data-selected=\"false\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\">add</span>\n          AutoCAD\n        </button>\n<button class=\"software-pill px-3 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-low text-on-surface flex items-center gap-1.5 transition-all\" data-selected=\"false\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\">add</span>\n          Blender\n        </button>\n<button class=\"software-pill px-3 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-low text-on-surface flex items-center gap-1.5 transition-all\" data-selected=\"false\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\">add</span>\n          Figma Desktop\n        </button>\n<button class=\"software-pill px-3 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-low text-on-surface flex items-center gap-1.5 transition-all\" data-selected=\"false\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\">add</span>\n          MATLAB\n        </button>\n</div>\n</div>\n<!-- Campo de Texto Adicional -->\n<div class=\"space-y-space-xs pt-1\">\n<label class=\"font-label-md text-label-md text-on-surface\" for=\"outros-softwares\">Outro software ou depend\303\252ncia espec\303\255fica</label>\n<input class=\"w-full h-12 px-4 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md placeholder-on-surface-variant/60 focus:outline-none focus:bg-surface-container-high transition-colors\" id=\"outros-softwares\" placeholder=\"ex: bibliotecas pip, Node v18, Docker compose\" type=\"text\"/>\n</div>\n</section>\n<!-- CTA de A\303\247\303\243o Prim\303\241ria -->\n<section class=\"pt-2\">\n<button class=\"w-full h-14 bg-primary-container text-on-primary rounded-xl font-title-md text-title-md shadow-md flex items-center justify-center gap-2 active:scale-[0.99] transition-transform\" type=\"button\">\n<span>Buscar Laborat\303\263rios Dispon\303\255veis</span>\n<span class=\"bg-primary text-on-primary font-label-sm text-label-sm px-2 py-0.5 rounded-full\">(4 compat\303\255veis)</span>\n<span class=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n</button>\n<p class=\"text-center font-label-sm text-label-sm text-on-surface-variant mt-2\">\n      Disponibilidade conferida em tempo real com o DTI\n    </p>\n</section>\n</div>\n<script>\n  // L\303\263gica Reativa do Contador de Alunos & Slider\n  const countDisplay = document.getElementById(\'student-count-display\');\n  const slider = document.getElementById(\'student-slider\');\n  const btnInc = document.getElementById(\'btn-increment\');\n  const btnDec = document.getElementById(\'btn-decrement\');\n  const warningText = document.getElementById(\'capacity-warning-text\');\n\n  function updateCount(val) {\n    let num = parseInt(val, 10);\n    if (isNaN(num)) num = 32;\n    num = Math.max(1, Math.min(50, num));\n    \n    countDisplay.textContent = num;\n    slider.value = num;\n    \n    const rec = num + 3;\n    warningText.innerHTML = `Recomendado labs com no m\303\255nimo <strong>${rec} esta\303\247\303\265es</strong> (reserva de margem).`;\n  }\n\n  slider.addEventListener(\'input\', (e) => updateCount(e.target.value));\n  btnInc.addEventListener(\'click\', () => updateCount(parseInt(slider.value, 10) + 1));\n  btnDec.addEventListener(\'click\', () => updateCount(parseInt(slider.value, 10) - 1));\n\n  // Sele\303\247\303\243o Din\303\242mica do Carrossel de Datas\n  const dateChips = document.querySelectorAll(\'.date-chip\');\n  const selectedDateText = document.getElementById(\'selected-date-text\');\n\n  dateChips.forEach(chip => {\n    chip.addEventListener(\'click\', () => {\n      dateChips.forEach(c => {\n        c.classList.remove(\'bg-primary\', \'text-on-primary\', \'shadow-sm\');\n        c.classList.add(\'bg-surface-container-low\', \'text-on-surface\');\n      });\n      chip.classList.remove(\'bg-surface-container-low\', \'text-on-surface\');\n      chip.classList.add(\'bg-primary\', \'text-on-primary\', \'shadow-sm\');\n      selectedDateText.textContent = chip.getAttribute(\'data-date\');\n    });\n  });\n\n  // Toggle de Chips de Softwares\n  const pills = document.querySelectorAll(\'.software-pill\');\n  pills.forEach(pill => {\n    pill.addEventListener(\'click\', () => {\n      const isSelected = pill.getAttribute(\'data-selected\') === \'true\';\n      const icon = pill.querySelector(\'.material-symbols-outlined\');\n      \n      if (isSelected) {\n        pill.setAttribute(\'data-selected\', \'false\');\n        pill.classList.remove(\'bg-primary-container\', \'text-on-primary\', \'shadow-sm\');\n        pill.classList.add(\'bg-surface-container-low\', \'text-on-surface\');\n        icon.textContent = \'add\';\n        icon.classList.add(\'text-on-surface-variant\');\n      } else {\n        pill.setAttribute(\'data-selected\', \'true\');\n        pill.classList.remove(\'bg-surface-container-low\', \'text-on-surface\');\n        pill.classList.add(\'bg-primary-container\', \'text-on-primary\', \'shadow-sm\');\n        icon.textContent = \'check_circle\';\n        icon.classList.remove(\'text-on-surface-variant\');\n      }\n    });\n  });\n</script></main><nav class=\"fixed bottom-0 inset-x-0 z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-2px_10px_rgba(0,0,0,0.04)]\" data-active-classes=\"text-primary font-label-md\"><div class=\"flex justify-around items-center h-16 px-space-xs\"><a class=\"flex flex-col items-center justify-center min-w-[64px] min-h-[44px] gap-0.5 text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"inicio\" href=\"#\"><span class=\"material-symbols-outlined text-[24px]\">calendar_today</span><span class=\"font-label-sm text-label-sm\">In\303\255cio</span></a><a aria-current=\"page\" class=\"flex flex-col items-center justify-center min-w-[64px] min-h-[44px] gap-0.5 transition-colors text-primary font-label-md\" data-path=\"nova-reserva\" href=\"#\"><div class=\"w-8 h-8 rounded-full bg-primary-container text-on-primary flex items-center justify-center shadow-sm\"><span class=\"material-symbols-outlined text-[20px]\">add</span></div><span class=\"font-label-sm text-label-sm\">Reservar</span></a><a class=\"flex flex-col items-center justify-center min-w-[64px] min-h-[44px] gap-0.5 text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"laboratorios\" href=\"#\"><span class=\"material-symbols-outlined text-[24px]\">desktop_windows</span><span class=\"font-label-sm text-label-sm\">Laborat\303\263rios</span></a><a class=\"flex flex-col items-center justify-center min-w-[64px] min-h-[44px] gap-0.5 text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"historico\" href=\"#\"><span class=\"material-symbols-outlined text-[24px]\">schedule</span><span class=\"font-label-sm text-label-sm\">Hist\303\263rico</span></a></div></nav></body></html>"

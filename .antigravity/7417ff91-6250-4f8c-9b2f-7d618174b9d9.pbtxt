  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { PROFESSOR_PROFILE } from \'../data/mockData\';\n\ninterface ProfileModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  activeCount: number;\n}\n\nexport const ProfileModal: React.FC<ProfileModalProps> = ({ isOpen, onClose, activeCount }) => {\n  if (!isOpen) return null;\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 bg-inverse-surface/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4 animate-in fade-in duration-200\"\n      onClick={onClose}\n    >\n      <div\n        className=\"bg-surface-container-lowest w-full max-w-md rounded-t-3xl sm:rounded-2xl p-6 shadow-2xl flex flex-col max-h-[90vh] overflow-y-auto animate-in slide-in-from-bottom duration-300\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        <div className=\"w-12 h-1.5 bg-outline-variant rounded-full mb-4 mx-auto sm:hidden\"></div>\n\n        <div className=\"flex flex-col items-center text-center pb-4 border-b border-outline-variant/30\">\n          <div className=\"relative mb-3\">\n            <img\n              alt={PROFESSOR_PROFILE.name}\n              className=\"w-20 h-20 rounded-full object-cover ring-4 ring-primary-fixed shadow-md\"\n              src={PROFESSOR_PROFILE.avatarUrl}\n            />\n            <span className=\"absolute bottom-0 right-0 w-5 h-5 rounded-full bg-secondary ring-2 ring-white flex items-center justify-center text-white text-[12px]\">\n              \342\234\223\n            </span>\n          </div>\n\n          <h3 className=\"font-headline-sm text-headline-sm text-on-surface font-bold\">\n            {PROFESSOR_PROFILE.name}\n          </h3>\n          <span className=\"font-label-md text-label-md text-primary font-semibold mt-0.5\">\n            SIAPE: {PROFESSOR_PROFILE.siape} \342\200\242 {PROFESSOR_PROFILE.role}\n          </span>\n          <p className=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">\n            {PROFESSOR_PROFILE.department}\n          </p>\n          <span className=\"font-label-sm text-label-sm text-outline mt-0.5\">\n            {PROFESSOR_PROFILE.institute}\n          </span>\n        </div>\n\n        <div className=\"py-4 space-y-3\">\n          <div className=\"bg-surface-container-low p-3.5 rounded-xl flex items-center justify-between\">\n            <div className=\"flex items-center gap-2.5\">\n              <span className=\"material-symbols-outlined text-primary text-[20px]\">badge</span>\n              <div className=\"flex flex-col\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant\">E-mail Institucional</span>\n                <span className=\"font-body-md text-body-md text-on-surface font-medium\">{PROFESSOR_PROFILE.email}</span>\n              </div>\n            </div>\n            <span className=\"material-symbols-outlined text-secondary text-[18px]\">verified</span>\n          </div>\n\n          <div className=\"bg-surface-container-low p-3.5 rounded-xl flex items-center justify-between\">\n            <div className=\"flex items-center gap-2.5\">\n              <span className=\"material-symbols-outlined text-primary text-[20px]\">calendar_month</span>\n              <div className=\"flex flex-col\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant\">Reservas Ativas</span>\n                <span className=\"font-body-md text-body-md text-on-surface font-semibold\">{activeCount} laborat\303\263rios alocados</span>\n              </div>\n            </div>\n            <span className=\"bg-secondary-container text-on-secondary-container font-label-sm text-label-sm px-2 py-0.5 rounded-full font-bold\">\n              Regular\n            </span>\n          </div>\n\n          <div className=\"bg-surface-container-low p-3.5 rounded-xl flex items-center justify-between\">\n            <div className=\"flex items-center gap-2.5\">\n              <span className=\"material-symbols-outlined text-primary text-[20px]\">support_agent</span>\n              <div className=\"flex flex-col\">\n                <span className=\"font-label-sm text-label-sm text-on-surface-variant\">Suporte do DTI</span>\n                <span className=\"font-body-md text-body-md text-on-surface font-medium\">Ramal 4090 \342\200\242 dti@universidade.edu.br</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <button\n          onClick={onClose}\n          type=\"button\"\n          className=\"w-full h-12 rounded-xl bg-surface-container text-on-surface font-label-lg text-label-lg hover:bg-surface-container-high transition-colors active:scale-95\"\n        >\n          Fechar\n        </button>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ProfileModal.tsx"
        }
        overwrite: true
      }
    }

a-public/AB6AXuDlKNP45fFEPE8-tOAuDHEAj7iXJe0uFkM0jJkpZZktmdQxE9Q5wR09uoj-iU91RMcE6EW65ZtNxwbWhB7z9fP35KgI3U0LIZZjUGiX0E-wi2LNVMQUr5DgVmv3OLE86iR86ThM3mCcGSMvrrY_UNBoVX0wtWTuQhAqyA8Pq2pNpiMSkyaRCeY6BG5rAxxrq-yc-kcdMZmUW3LA5bhgUxSrjH75se-quNWoZIXqpZaP_mvT7D4Fs75_zg\"/></div></div></header><main class=\"flex-1 flex flex-col relative w-full pt-16 bg-surface\"><div class=\"flex flex-col w-full pb-safe\">\n<div class=\"px-margin pt-space-md pb-space-lg flex flex-col items-center text-center\">\n<!-- Animated Success Badge -->\n<div class=\"relative flex items-center justify-center w-20 h-20 mb-space-md\">\n<div class=\"absolute inset-0 rounded-full bg-secondary-container/50 animate-ping opacity-75\"></div>\n<div class=\"relative w-20 h-20 rounded-full bg-secondary-container flex items-center justify-center shadow-md\">\n<span class=\"material-symbols-outlined text-[44px] text-on-secondary-container\" style=\"font-variation-settings: \'FILL\' 1, \'wght\' 700;\">check_circle</span>\n</div>\n</div>\n<!-- Title & Subtitle -->\n<h2 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-xs\">\n      Reserva Confirmada!\n    </h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant max-w-xs\">\n      Sua aloca\303\247\303\243o de laborat\303\263rio foi processada e aprovada pelo departamento acad\303\252mico.\n    </p>\n<!-- Protocol Snippet -->\n<div class=\"mt-space-md inline-flex items-center gap-space-sm bg-surface-container-high px-space-md py-space-xs rounded-full\">\n<span class=\"font-label-md text-label-md text-on-surface-variant\">Protocolo:</span>\n<span class=\"font-title-md text-title-md text-primary tracking-wide\" id=\"protocol-code\">#LR-2023-8941</span>\n<button aria-label=\"Copiar c\303\263digo de protocolo\" class=\"flex items-center justify-center w-8 h-8 rounded-full bg-surface-container hover:bg-surface-variant transition-colors active:scale-95 text-primary\" id=\"copy-btn\" onclick=\"copyProtocol()\">\n<span class=\"material-symbols-outlined text-[18px]\" id=\"copy-icon\">content_copy</span>\n</button>\n</div>\n</div>\n<div class=\"px-margin flex flex-col gap-space-lg mb-space-xl\">\n<!-- Stylized Boarding Pass / Ticket -->\n<div class=\"relative bg-surface-container-lowest rounded-xl shadow-md overflow-hidden\">\n<!-- Laboratory Spotlight Header -->\n<div class=\"relative h-28 w-full overflow-hidden\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A modern, high-tech university computer lab with glowing dual monitors, sleek ergonomic black chairs, and soft atmospheric blue LED lighting against polished concrete floors.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBD2Co1JjGyCh6mgvhBjn8ujEzM6E_2gmAKxWNF4vFNpNflc3hRGBtuHlp6FbWCuWGusIDoi2WTw-Uy8RKT4xZZ1SJVo4nsuY09dWNaNcSsC2WKncGkVZKiRYjBwP3v2ge_fNBmKLEXdes00u6CI_bcSojYsswdCSuzz4yW7T0OEDslcF_XYbLoY_SVE6-n2L5dnIbzBYYIHDBrOHlQlrsHuRexPyZ9srXBasdMDaM22MmtvI9Zj9t2tQ\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/40 to-transparent\"></div>\n<div class=\"absolute top-space-sm left-space-md bg-surface/90 backdrop-blur-md px-space-sm py-0.5 rounded-full flex items-center gap-1 shadow-sm\">\n<span class=\"w-2 h-2 rounded-full bg-secondary animate-pulse\"></span>\n<span class=\"font-label-sm text-label-sm text-secondary font-bold\">Sala Autenticada</span>\n</div>\n</div>\n<!-- Ticket Body Content -->\n<div class=\"px-space-md pt-space-xs pb-space-md flex flex-col gap-space-md\">\n<div>\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant\">Disciplina &amp; Curso</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface mt-0.5\">Desenvolvimento Web &amp; Mobile</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"material-symbols-outlined text-[16px] text-outline\">school</span>\n            Prof. Dr. Andr\303\251 Silva (SIAPE: 198421)\n          </p>\n</div>\n<div class=\"grid grid-cols-2 gap-space-sm bg-surface-container-low p-space-sm rounded-lg\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Laborat\303\263rio</span>\n<span class=\"font-title-md text-title-md text-on-surface font-semibold\">Lab 04</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Bloco B, Sala 204</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Capacidade / Lota\303\247\303\243o</span>\n<span class=\"font-title-md text-title-md text-on-surface font-semibold\">32 Alunos</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Total: 40 Esta\303\247\303\265es</span>\n</div>\n</div>\n<div class=\"flex items-start gap-space-sm\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center shrink-0 text-primary\">\n<span class=\"material-symbols-outlined text-[20px]\">calendar_today</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-title-md text-title-md text-on-surface\">Sexta-feira, 27 de Outubro</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant font-medium\">14:00 \303\240s 17:30 (Dura\303\247\303\243o: 3h30min)</span>\n</div>\n</div>\n<div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant block mb-1\">Ambiente de Software Preparado</span>\n<div class=\"flex flex-wrap gap-1.5\">\n<span class=\"font-label-sm text-label-sm px-2.5 py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-semibold flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\">terminal</span> Android Studio 2023.2\n            </span>\n<span class=\"font-label-sm text-label-sm px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface-variant font-medium\">\n              VS Code\n            </span>\n<span class=\"font-label-sm text-label-sm px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface-variant font-medium\">\n              PostgreSQL 15\n            </span>\n</div>\n</div>\n</div>\n<!-- Ticket Perforated Divider with Cutout Circles -->\n<div class=\"relative w-full h-8 flex items-center justify-between\">\n<div class=\"w-4 h-8 bg-surface rounded-r-full -ml-0.5 shadow-inner\"></div>\n<div class=\"flex-1 border-t-2 border-dashed border-outline-variant mx-2 opacity-60\"></div>\n<div class=\"w-4 h-8 bg-surface rounded-l-full -mr-0.5 shadow-inner\"></div>\n</div>\n<!-- Ticket Bottom: QR Code Digital Access Key -->\n<div class=\"px-space-md pt-space-xs pb-space-lg flex flex-col items-center text-center\">\n<div class=\"p-3 bg-surface-container-lowest rounded-xl shadow-sm mb-space-sm flex flex-col items-center\">\n<!-- Stylized High-Fidelity SVG QR Representation -->\n<svg class=\"w-36 h-36\" fill=\"none\" viewbox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\">\n<rect fill=\"#FFFFFF\" height=\"100\" rx=\"8\" width=\"100\"></rect>\n<!-- Top Left Finder Pattern -->\n<rect fill=\"#131B2E\" height=\"24\" rx=\"4\" width=\"24\" x=\"8\" y=\"8\"></rect>\n<rect fill=\"#FFFFFF\" height=\"16\" rx=\"2\" width=\"16\" x=\"12\" y=\"12\"></rect>\n<rect fill=\"#0037B0\" height=\"8\" rx=\"1.5\" width=\"8\" x=\"16\" y=\"16\"></rect>\n<!-- Top Right Finder Pattern -->\n<rect fill=\"#131B2E\" height=\"24\" rx=\"4\" width=\"24\" x=\"68\" y=\"8\"></rect>\n<rect fill=\"#FFFFFF\" height=\"16\" rx=\"2\" width=\"16\" x=\"72\" y=\"12\"></rect>\n<rect fill=\"#0037B0\" height=\"8\" rx=\"1.5\" width=\"8\" x=\"76\" y=\"16\"></rect>\n<!-- Bottom Left Finder Pattern -->\n<rect fill=\"#131B2E\" height=\"24\" rx=\"4\" width=\"24\" x=\"8\" y=\"68\"></rect>\n<rect fill=\"#FFFFFF\" height=\"16\" rx=\"2\" width=\"16\" x=\"12\" y=\"72\"></rect>\n<rect fill=\"#0037B0\" height=\"8\" rx=\"1.5\" width=\"8\" x=\"16\" y=\"76\"></rect>\n<!-- Stylized Data Matrix Dots -->\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"36\" y=\"10\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"46\" y=\"10\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"56\" y=\"14\"></rect>\n<rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"36\" y=\"20\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"46\" y=\"24\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"10\" y=\"36\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"20\" y=\"38\"></rect>\n<rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"10\" y=\"48\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"20\" y=\"56\"></rect>\n<rect fill=\"#0037B0\" height=\"8\" rx=\"2\" width=\"8\" x=\"36\" y=\"36\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"48\" y=\"36\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"58\" y=\"38\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"70\" y=\"36\"></rect>\n<rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"82\" y=\"38\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"36\" y=\"48\"></rect>\n<rect fill=\"#131B2E\" height=\"8\" rx=\"2\" width=\"8\" x=\"46\" y=\"48\"></rect>\n<rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"58\" y=\"48\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"76\" y=\"48\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"36\" y=\"60\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"46\" y=\"60\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"56\" y=\"62\"></rect>\n<rect fill=\"#131B2E\" height=\"8\" rx=\"2\" width=\"8\" x=\"68\" y=\"60\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"80\" y=\"62\"></rect>\n<rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"36\" y=\"74\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"48\" y=\"72\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"58\" y=\"76\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"70\" y=\"74\"></rect>\n<rect fill=\"#0037B0\" height=\"6\" rx=\"1\" width=\"6\" x=\"82\" y=\"76\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"40\" y=\"84\"></rect>\n<rect fill=\"#0037B0\" height=\"8\" rx=\"2\" width=\"8\" x=\"52\" y=\"84\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"66\" y=\"86\"></rect>\n<rect fill=\"#131B2E\" height=\"6\" rx=\"1\" width=\"6\" x=\"78\" y=\"84\"></rect>\n</svg>\n</div>\n<div class=\"flex items-center gap-1.5 text-secondary font-semibold font-label-md text-label-md\">\n<span class=\"material-symbols-outlined text-[16px]\">lock_open</span>\n          Chave Digital de Acesso\n        </div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 max-w-xs\">\n          Aproxime este QR Code na fechadura da Sala 204 para liberar a entrada 15 min antes.\n        </p>\n</div>\n</div>\n<!-- IT Support Status Card -->\n<div class=\"bg-surface-container-high rounded-xl p-space-md flex items-start gap-space-sm shadow-sm\">\n<div class=\"w-10 h-10 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">dns</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-md text-label-md text-on-surface font-semibold flex items-center gap-1\">\n          Status da TI: M\303\241quinas Validadas\n          <span class=\"inline-block w-2 h-2 rounded-full bg-secondary\"></span>\n</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n          Todos os softwares solicitados j\303\241 est\303\243o em cache e sincronizados nas 40 esta\303\247\303\265es de trabalho.\n        </p>\n</div>\n</div>\n<!-- Action Buttons -->\n<div class=\"flex flex-col gap-space-sm\">\n<button class=\"w-full h-12 rounded-lg bg-primary text-on-primary font-label-lg text-label-lg flex items-center justify-center gap-2 shadow-sm active:bg-primary-container transition-all\" onclick=\"handleAddToCalendar()\">\n<span class=\"material-symbols-outlined text-[20px]\">event</span>\n        Adicionar \303\240 Agenda (Google / Outlook)\n      </button>\n<button class=\"w-full h-12 rounded-lg bg-surface-container-highest text-on-surface font-label-lg text-label-lg flex items-center justify-center gap-2 active:bg-surface-dim transition-all\" onclick=\"handleShareTicket()\">\n<span class=\"material-symbols-outlined text-[20px]\">share</span>\n        Compartilhar com os Alunos / Baixar PDF\n      </button>\n<button class=\"w-full py-space-sm text-center text-primary font-label-md text-label-md hover:underline transition-all\" onclick=\"history.back()\">\n        Voltar para a P\303\241gina Inicial\n      </button>\n</div>\n</div>\n<!-- Micro-Toast for copied feedback -->\n<div class=\"fixed bottom-6 inset-x-4 max-w-xs mx-auto bg-inverse-surface text-inverse-on-surface px-space-md py-space-sm rounded-full shadow-lg flex items-center justify-center gap-2 opacity-0 pointer-events-none transition-opacity duration-300 z-50\" id=\"toast-copied\">\n<span class=\"material-symbols-outlined text-[18px] text-secondary-fixed\">check</span>\n<span class=\"font-body-sm text-body-sm\">C\303\263digo copiado com sucesso!</span>\n</div>\n</div>\n<script>\n  function copyProtocol() {\n    const text = \"#LR-2023-8941\";\n    navigator.clipboard.writeText(text).then(() => {\n      const toast = document.getElementById(\'toast-copied\');\n      const icon = document.getElementById(\'copy-icon\');\n      \n      icon.textContent = \'done\';\n      toast.classList.remove(\'opacity-0\', \'pointer-events-none\');\n      toast.classList.add(\'opacity-100\');\n      \n      setTimeout(() => {\n        icon.textContent = \'content_copy\';\n        toast.classList.add(\'opacity-0\', \'pointer-events-none\');\n        toast.classList.remove(\'opacity-100\');\n      }, 2400);\n    }).catch(() => {\n      const toast = document.getElementById(\'toast-copied\');\n      toast.textContent = \"C\303\263digo: \" + text;\n      toast.classList.remove(\'opacity-0\', \'pointer-events-none\');\n      setTimeout(() => toast.classList.add(\'opacity-0\'), 2000);\n    });\n  }\n\n  function handleAddToCalendar() {\n    const title = encodeURIComponent(\"Reserva: Lab 04 - Desenvolvimento Web & Mobile\");\n    const details = encodeURIComponent(\"Laborat\303\263rio de Inform\303\241tica 04 (Bloco B, Sala 204). Protocolo: #LR-2023-8941\");\n    const location = encodeURIComponent(\"Bloco B, Sala 204 - Lab de Inform\303\241tica\");\n    const googleCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&details=${details}&location=${location}&dates=20231027T170000Z/20231027T203000Z`;\n    window.open(googleCalUrl, \'_blank\');\n  }\n\n  function handleShareTicket() {\n    if (navigator.share) {\n      navigator.share({\n        title: \'Comprovante LabReserve\',\n        text: \'Reserva confirmada no Lab 04 (Bloco B, Sala 204) - 27/10 das 14h \303\240s 17h30. Protocolo: #LR-2023-8941\',\n        url: window.location.href,\n      }).catch(() => {});\n    } else {\n      copyProtocol();\n    }\n  }\n</script></main></body></html>"

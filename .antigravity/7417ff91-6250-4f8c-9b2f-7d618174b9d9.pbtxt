      thinking_signature: "\022\312\r\n\307\r\001i\024}\023,\267\346t\356\rbk\\RL\033l\030u\253om0df\307\002a\022T*\266Q\224A\211\177\331\241\360\234\261_H\2420C\245D\333E6Ax\254[\240\027B\250F\307\332I\235\246\354of\016,\235\215\337\352\311\366\2158\276)\b\257?\341?n\f\344\226\316Yf\265\022\3723\227\250\263\357\33286)<\324\355~\216;c\261\340\254\210\350s\f\325\004\332F\211\301h\027\355\242\000|\246\002\374\236\230\3624\211\211.\r:3_\273U/\366a\251Jtm\224\2030\304M|\312s_\253\237\257\027K\266\231\030\335\250?\216w\361>\267\375\227\3750\247zk\000\017\020\tc\270\037\213\255\325S\r\331r\342\036\v\016\021\222g\215i\247\f\016t\020\243\366\224\236\264v\345\250\357\351\301/\024\202\250\270\037\333\243\v\236\302\260?\356\\4S\025\324W\224\322i\270\243\265A\003\245\036\320\n\027\031\211\201\204\235\321\351Q\340\372\315\356#Y[\230\024[\246Vf\203VV\214W|O\006c\035\274\266\362\350b\223\024q\345\033\302\346\376,\335?\373It\037K\036)s\247\353\230\332<\274]\327O\257\232\3734\274q\214Ov9\327Ra\277\322\316X*O9\324cs\020n)H|9\376\203g\337\227\032f\316\336-\233i1,9R!r\336N\346I\356\331\037\f\316\371\341\004\320\255\201;7\254\317\257\256\230\217:\361\312(\344\313b\370&r\216\377\347\336-\322\3108\352y\377\337\035\255\362\215\342W\266\024\221v\267F!\363sD\331\354\376\264\317\374\343v\342\247\256\237\300\351\200\305\f\371\244\300\366\333\365]\255W@\240/\227\254\346f\252\254\251\254\234t\323C\206\"\377\324\364\261e\234\a\2311\336?rt;\366Im\3166\203>\336\237\232\221\306\bMR\353B\222\352\030@\257\2244\033\241\207:\004\230{5\035\206\216\233\372\377W\247\322\032\230\331f\004\2579\372+\275/Q\276|AkC\327a\304\311x\350\027\2415\270D\r\264\203\263?<mW\f\266\b\2746P\024\020\r\366\333:\t\335\346\373Kd0\251O\230\217G5\n_\315\327\247\036\200\032\206\303\332U\265\202G\330\270\215R\275\352\032\005F\231wclT#LW7@\211\232\213\3056\273\3576\255)\244\034\317\r\372\227\235~\222`\357\'0R&\021\233e\336\366\260\213x\251\207o\035\341\304\363}\323\215E\253\251l\201\na\247n\031{\303\f\3112\226\221TM[\323\206\226\303
    content: "<!DOCTYPE html>\n\n<html lang=\"pt-BR\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_tab\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"secondary-fixed-dim\": \"#4edea3\", \"secondary\": \"#006c49\", \"background\": \"#faf8ff\", \"surface-dim\": \"#d2d9f4\", \"on-tertiary-fixed-variant\": \"#653e00\", \"on-secondary-fixed-variant\": \"#005236\", \"tertiary-container\": \"#825100\", \"tertiary-fixed-dim\": \"#ffb95f\", \"on-secondary\": \"#ffffff\", \"secondary-container\": \"#6cf8bb\", \"on-background\": \"#131b2e\", \"on-tertiary\": \"#ffffff\", \"outline-variant\": \"#c4c5d7\", \"on-tertiary-fixed\": \"#2a1700\", \"on-tertiary-container\": \"#ffcb8f\", \"inverse-on-surface\": \"#eef0ff\", \"on-primary-container\": \"#cad3ff\", \"surface-bright\": \"#faf8ff\", \"on-secondary-fixed\": \"#002113\", \"secondary-fixed\": \"#6ffbbe\", \"on-surface-variant\": \"#434655\", \"on-primary-fixed-variant\": \"#0039b5\", \"primary-container\": \"#1d4ed8\", \"tertiary\": \"#623c00\", \"surface-container\": \"#eaedff\", \"surface\": \"#faf8ff\", \"on-secondary-container\": \"#00714d\", \"outline\": \"#747686\", \"surface-tint\": \"#2151da\", \"surface-container-low\": \"#f2f3ff\", \"surface-variant\": \"#dae2fd\", \"on-error\": \"#ffffff\", \"primary\": \"#0037b0\", \"on-primary\": \"#ffffff\", \"error-container\": \"#ffdad6\", \"primary-fixed-dim\": \"#b7c4ff\", \"primary-fixed\": \"#dce1ff\", \"tertiary-fixed\": \"#ffddb8\", \"surface-container-highest\": \"#dae2fd\", \"inverse-surface\": \"#283044\", \"on-primary-fixed\": \"#001551\", \"surface-container-high\": \"#e2e7ff\", \"inverse-primary\": \"#b7c4ff\", \"error\": \"#ba1a1a\", \"on-surface\": \"#131b2e\", \"on-error-container\": \"#93000a\", \"surface-container-lowest\": \"#ffffff\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"margin\": \"1rem\", \"space-md\": \"1rem\", \"space-xl\": \"2rem\", \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"space-lg\": \"1.5rem\", \"space-sm\": \"0.5rem\" }, fontFamily: { \"body-sm\": [\"Plus Jakarta Sans\"], \"display-lg\": [\"Plus Jakarta Sans\"], \"headline-md\": [\"Plus Jakarta Sans\"], \"label-md\": [\"Plus Jakarta Sans\"], \"title-md\": [\"Plus Jakarta Sans\"], \"label-lg\": [\"Plus Jakarta Sans\"], \"body-md\": [\"Plus Jakarta Sans\"], \"headline-sm\": [\"Plus Jakarta Sans\"], \"headline-lg\": [\"Plus Jakarta Sans\"], \"label-sm\": [\"Plus Jakarta Sans\"], \"body-lg\": [\"Plus Jakarta Sans\"] }, fontSize: { \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"display-lg\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }], \"headline-md\": [\"20px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"600\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"title-md\": [\"16px\", { \"lineHeight\": \"22px\", \"fontWeight\": \"600\" }], \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"headline-lg\": [\"24px\", { \"lineHeight\": \"32px\", \"letterSpacing\": \"-0.015em\", \"fontWeight\": \"700\" }], \"label-sm\": [\"11px\", { \"lineHeight\": \"14px\", \"letterSpacing\": \"0.03em\", \"fontWeight\": \"600\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }] } } } };</script><style>@layer base{html,body{width:100%;min-height:100%;margin:0;padding:0;}body{overscroll-behavior-y:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 inset-x-0 z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] pt-safe\"><div class=\"h-16 px-gutter flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><img alt=\"LabReserve Logo\" class=\"h-8 w-auto object-contain\" src=\"https://lh3.googleusercontent.com/aida/AEtjO1Xzpg_lS837oxSWCBlplqPFSe1nt2DTJ1AIdxqjatdVzRrR7i6J-ArBIpCR6ujvUTgfC9O5dPLrB8ZV1ZJYL7ctGQTOoSPZMHulQoRSa17Fv4mVDg6guuDd_z4Q1-Am2nDV7JbPb4CYe7bfR9ynMp_HVCn7f_nOCgeOPDsxkItcLA-B5UshpN73NcvRVRgyEoqgpzWF1HoK1mVzTQUgkBBPLuo0iR77yd1E9e6Y0-C7UqN-1DzRzCOViMI\"/><div class=\"flex flex-col\"><span class=\"font-headline-sm text-headline-sm text-primary leading-none\">LabReserve</span><span class=\"font-label-sm text-label-sm text-on-surface-variant leading-none mt-0.5\">Laborat\303\263rios</span></div></div><div class=\"flex items-center gap-space-sm\"><button aria-label=\"Notifica\303\247\303\265es\" class=\"w-11 h-11 flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors\"><span class=\"material-symbols-outlined text-[24px]\">notifications</span></button><div class=\"flex items-center gap-space-xs\"><img alt=\"Profile\" class=\"w-8 h-8 rounded-full object-cover ring-2 ring-primary-fixed\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDlKNP45fFEPE8-tOAuDHEAj7iXJe0uFkM0jJkpZZktmdQxE9Q5wR09uoj-iU91RMcE6EW65ZtNxwbWhB7z9fP35KgI3U0LIZZjUGiX0E-wi2LNVMQUr5DgVmv3OLE86iR86ThM3mCcGSMvrrY_UNBoVX0wtWTuQhAqyA8Pq2pNpiMSkyaRCeY6BG5rAxxrq-yc-kcdMZmUW3LA5bhgUxSrjH75se-quNWoZIXqpZaP_mvT7D4Fs75_zg\"/></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full pt-16 pb-24 bg-surface\"><div class=\"flex flex-col w-full\">\n<div class=\"px-gutter pt-space-md pb-space-xs flex flex-col gap-space-sm\">\n<div class=\"bg-surface-container-lowest rounded-xl p-space-sm shadow-sm flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs min-w-0\">\n<div class=\"w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary shrink-0\">\n<span class=\"material-symbols-outlined text-[18px]\">tune</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant truncate\">Filtros aplicados</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold truncate\">27 Out \342\200\242 14:00 - 17:30 \342\200\242 32 Alunos</span>\n</div>\n</div>\n<button class=\"px-space-sm py-1.5 rounded-lg bg-surface-container text-primary font-label-sm text-label-sm font-semibold active:scale-95 transition-all shrink-0\" type=\"button\">\n        Editar\n      </button>\n</div>\n<div class=\"bg-surface-container-high rounded-xl p-space-sm shadow-sm flex items-center gap-space-sm\">\n<div class=\"w-9 h-9 rounded-full bg-secondary text-on-secondary flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: \'FILL\' 1;\">verified</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\">4 laborat\303\263rios encontrados</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">2 com suporte imediato e 2 com requisitos parciais</span>\n</div>\n</div>\n</div>\n<div class=\"px-gutter py-space-sm flex flex-col gap-space-md\">\n<!-- Lab 1: Destaque Perfeito -->\n<article class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm relative flex flex-col gap-space-sm transition-all\" id=\"lab-card-1\">\n<div class=\"flex items-start justify-between gap-space-xs\">\n<div class=\"flex flex-col\">\n<div class=\"flex items-center gap-1.5 mb-1\">\n<span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm font-semibold\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-secondary\"></span>\n              100% Compat\303\255vel\n            </span>\n<span class=\"inline-flex items-center px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">\n              Bloco B \342\200\242 2\302\272 Andar\n            </span>\n</div>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Laborat\303\263rio 04 - Desenvolvimento</h2>\n</div>\n<div class=\"w-10 h-10 rounded-full bg-surface-container-low flex items-center justify-center text-primary shrink-0\">\n<span class=\"material-symbols-outlined text-[24px]\">terminal</span>\n</div>\n</div>\n<div class=\"grid grid-cols-2 gap-space-xs py-space-xs\">\n<div class=\"bg-surface-container-low rounded-lg p-space-sm flex flex-col justify-center\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Lota\303\247\303\243o</span>\n<span class=\"font-title-md text-title-md text-on-surface font-semibold\">40 Computadores</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Sobra de 8 esta\303\247\303\265es</span>\n</div>\n<div class=\"bg-surface-container-low rounded-lg p-space-sm flex flex-col justify-center\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Hardware</span>\n<span class=\"font-title-md text-title-md text-on-surface font-semibold\">Intel Core i7</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">16GB RAM \342\200\242 SSD 512GB</span>\n</div>\n</div>\n<div class=\"flex flex-col gap-1.5\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold\">Softwares Instalados</span>\n<div class=\"flex flex-wrap gap-1.5\">\n<span class=\"px-2.5 py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm font-semibold flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\">check</span> Android Studio\n          </span>\n<span class=\"px-2.5 py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm font-semibold flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\">check</span> VS Code\n          </span>\n<span class=\"px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">PostgreSQL</span>\n<span class=\"px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">Git</span>\n</div>\n</div>\n<div class=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-on-surface-variant pt-space-xs\">\n<span class=\"font-body-sm text-body-sm flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px]\">ac_unit</span> Ar Condicionado\n        </span>\n<span class=\"font-body-sm text-body-sm flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px]\">videocam</span> Projetor 4K\n        </span>\n<span class=\"font-body-sm text-body-sm flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px]\">draw</span> Quadro Branco\n        </span>\n<span class=\"font-body-sm text-body-sm flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px]\">bolt</span> Nobreak Central\n
      id: "call_1644126"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"/**\\n * @license\\n * SPDX-License-Identifier: Apache-2.0\\n */\\n\\nimport React, { useState, useEffect } from \'react\';\\nimport { Header } from \'./components/Header\';\\nimport { BottomNav, NavTab } from \'./components/BottomNav\';\\nimport { HomeScreen } from \'./components/HomeScreen\';\\nimport { ReservationWizard } from \'./components/ReservationWizard\';\\nimport { LabsDirectoryScreen } from \'./components/LabsDirectoryScreen\';\\nimport { HistoryScreen } from \'./components/HistoryScreen\';\\nimport { QrAccessModal } from \'./components/QrAccessModal\';\\nimport { SoftwareRequestModal } from \'./components/SoftwareRequestModal\';\\nimport { NotificationsDrawer } from \'./components/NotificationsDrawer\';\\nimport { ProfileModal } from \'./components/ProfileModal\';\\nimport {\\n  INITIAL_LABS,\\n  INITIAL_RESERVATIONS,\\n  INITIAL_NOTIFICATIONS,\\n} from \'./data/mockData\';\\nimport { Lab, Reservation, NotificationItem } from \'./types\';\\n\\nexport default function App() {\\n  const [currentTab, setCurrentTab] = useState<NavTab>(\'inicio\');\\n\\n  // Persistence with localStorage\\n  const [labs, setLabs] = useState<Lab[]>(() => {\\n    const saved = localStorage.getItem(\'labreserve_labs\');\\n    return saved ? JSON.parse(saved) : INITIAL_LABS;\\n  });\\n\\n  const [reservations, setReservations] = useState<Reservation[]>(() => {\\n    const saved = localStorage.getItem(\'labreserve_reservations\');\\n    return saved ? JSON.parse(saved) : INITIAL_RESERVATIONS;\\n  });\\n\\n  const [notifications, setNotifications] = useState<NotificationItem[]>(() => {\\n    const saved = localStorage.getItem(\'labreserve_notifications\');\\n    return saved ? JSON.parse(saved) : INITIAL_NOTIFICATIONS;\\n  });\\n\\n  // Modals & Drawers state\\n  const [qrModalReservation, setQrModalReservation] = useState<Reservation | null>(null);\\n  const [softwareRequestModalOpen, setSoftwareRequestModalOpen] = useState(false);\\n  const [profileModalOpen, setProfileModalOpen] = useState(false);\\n  const [notificationsDrawerOpen, setNotificationsDrawerOpen] = useState(false);\\n\\n  // Deep view state for Reservation Wizard\\n  const [viewingTicketReservation, setViewingTicketReservation] = useState<Reservation | null>(null);\\n  const [initialLabForWizard, setInitialLabForWizard] = useState<string | null>(null);\\n\\n  // Sync to localStorage\\n  useEffect(() => {\\n    localStorage.setItem(\'labreserve_reservations\', JSON.stringify(reservations));\\n  }, [reservations]);\\n\\n  useEffect(() => {\\n    localStorage.setItem(\'labreserve_labs\', JSON.stringify(labs));\\n  }, [labs]);\\n\\n  useEffect(() => {\\n    localStorage.setItem(\'labreserve_notifications\', JSON.stringify(notifications));\\n  }, [notifications]);\\n\\n  // Handlers\\n  const handleAddNewReservation = (newRes: Reservation) => {\\n    setReservations((prev) => [newRes, ...prev]);\\n\\n    // Add a notification for this booking\\n    const newNotif: NotificationItem = {\\n      id: `notif-${Date.now()}`,\\n      title: `Reserva confirmada: ${newRes.labName}`,\\n      description: `Aloca\303\247\303\243o gerada para ${newRes.subject} no dia ${newRes.dateFormatted}. Protocolo ${newRes.protocol}.`,\\n      timestamp: \'Agora mesmo\',\\n      read: false,\\n      type: \'success\',\\n    };\\n    setNotifications((prev) => [newNotif, ...prev]);\\n  };\\n\\n  const handleCancelReservation = (resId: string) => {\\n    setReservations((prev) => prev.filter((r) => r.id !== resId));\\n    const cancelNotif: NotificationItem = {\\n      id: `notif-${Date.now()}`,\\n      title: \'Reserva cancelada com sucesso\',\\n      description: \'A sala e as esta\303\247\303\265es foram liberadas no sistema para outros professores.\',\\n      timestamp: \'Agora mesmo\',\\n      read: false,\\n      type: \'info\',\\n    };\\n    setNotifications((prev) => [cancelNotif, ...prev]);\\n  };\\n\\n  const handleSoftwareRequestSubmitted = (data: { labId: string; softwareName: string; justification: string }) => {\\n    const targetLab = labs.find((l) => l.id === data.labId);\\n    const labName = targetLab ? targetLab.name : \'Laborat\303\263rio\';\\n\\n    const newNotif: NotificationItem = {\\n      id: `notif-${Date.now()}`,\\n      title: `Chamado DTI aberto para ${labName}`,\\n      description: `Instala\303\247\303\243o do pacote ${data.softwareName} solicitada. Previs\303\243o de atendimento em ~2 horas.`,\\n      timestamp: \'Agora mesmo\',\\n      read: false,\\n      type: \'warning\',\\n    };\\n    setNotifications((prev) => [newNotif, ...prev]);\\n  };\\n\\n  const handleSelectLabForReservation = (lab: Lab) => {\\n    setInitialLabForWizard(lab.id);\\n    setViewingTicketReservation(null);\\n    setCurrentTab(\'nova-reserva\');\\n  };\\n\\n  const handleViewTicketFromAnywhere = (res: Reservation) => {\\n    setViewingTicketReservation(res);\\n    setCurrentTab(\'nova-reserva\');\\n  };\\n\\n  const handleBack = () => {\\n    if (viewingTicketReservation) {\\n      setViewingTicketReservation(null);\\n      setCurrentTab(\'inicio\');\\n    } else if (currentTab !== \'inicio\') {\\n      setCurrentTab(\'inicio\');\\n    }\\n  };\\n\\n  // Header Subtitle Text\\n  const getHeaderSubtitle = () => {\\n    if (viewingTicketReservation) return \'Comprovante De Reserva\';\\n    switch (currentTab) {\\n      case \'inicio\':\\n        return \'In\303\255cio\';\\n      case \'nova-reserva\':\\n        return \'Nova Reserva\';\\n      case \'laboratorios\':\\n        return \'Laborat\303\263rios\';\\n      case \'historico\':\\n        return \'Hist\303\263rico\';\\n      default:\\n        return \'Laborat\303\263rios\';\\n    }\\n  };\\n\\n  const unreadCount = notifications.filter((n) => !n.read).length;\\n\\n  return (\\n    <div className=\\\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen selection:bg-primary-container selection:text-white\\\">\\n      {/* Fixed Header */}\\n      <Header\\n        subtitle={getHeaderSubtitle()}\\n        showBack={currentTab !== \'inicio\' || viewingTicketReservation !== null}\\n        onBack={handleBack}\\n        onOpenNotifications={() => setNotificationsDrawerOpen(true)}\\n        onOpenProfile={() => setProfileModalOpen(true)}\\n        unreadCount={unreadCount}\\n      />\\n\\n      {/* Main Content Body */}\\n      <main className=\\\"flex-1 flex flex-col relative w-full pt-16 bg-surface max-w-xl mx-auto min-h-screen\\\">\\n        {currentTab === \'inicio\' && (\\n          <HomeScreen\\n            reservations={reservations}\\n            onStartReservation={() => {\\n              setViewingTicketReservation(null);\\n              setInitialLabForWizard(null);\\n              setCurrentTab(\'nova-reserva\');\\n            }}\\n            onViewLabs={() => setCurrentTab(\'laboratorios\')}\\n            onOpenSoftwareRequest={() => setSoftwareRequestModalOpen(true)}\\n            onOpenQrModal={(res) => setQrModalReservation(res)}\\n            onViewReservationTicket={handleViewTicketFromAnywhere}\\n            onViewAllHistory={() => setCurrentTab(\'historico\')}\\n          />\\n        )}\\n\\n        {currentTab === \'nova-reserva\' && (\\n          <ReservationWizard\\n            key={viewingTicketReservation ? viewingTicketReservation.id : \'wizard-active\'}\\n            labs={labs}\\n            initialLabId={initialLabForWizard}\\n            activeReservationForTicket={viewingTicketReservation}\\n            onFinishReservation={(newRes) => {\\n              handleAddNewReservation(newRes);\\n            }}\\n            onCancel={() => {\\n              setViewingTicketReservation(null);\\n              setCurrentTab(\'inicio\');\\n            }}\\n          />\\n        )}\\n\\n        {currentTab === \'laboratorios\' && (\\n          <LabsDirectoryScreen\\n            labs={labs}\\n            onSelectLabForReservation={handleSelectLabForReservation}\\n            onRequestSoftwareForLab={() => setSoftwareRequestModalOpen(true)}\\n          />\\n        )}\\n\\n        {currentTab === \'historico\' && (\\n          <HistoryScreen\\n            reservations={reservations}\\n            onViewTicket={handleViewTicketFromAnywhere}\\n            onOpenQrModal={(res) => setQrModalReservation(res)}\\n            onCancelReservation={handleCancelReservation}\\n            onStartNewReservation={() => {\\n              setViewingTicketReservation(null);\\n              setInitialLabForWizard(null);\\n              setCurrentTab(\'nova-reserva\');\\n            }}\\n          />\\n        )}\\n      </main>\\n\\n      {/* Fixed Bottom Navigation */}\\n      <BottomNav\\n        currentTab={currentTab}\\n        onSelectTab={(tab) => {\\n          setViewingTicketReservation(null);\\n          setCurrentTab(tab);\\n          window.scrollTo({ top: 0, behavior: \'smooth\' });\\n        }}\\n      />\\n\\n      {/* Auxiliary Modals & Drawers */}\\n      <QrAccessModal\\n        isOpen={qrModalReservation !== null}\\n        onClose={() => setQrModalReservation(null)}\\n        reservation={qrModalReservation}\\n      />\\n\\n      <SoftwareRequestModal\\n        isOpen={softwareRequestModalOpen}\\n        onClose={() => setSoftwareRequestModalOpen(false)}\\n        labs={labs}\\n        onRequestSubmitted={handleSoftwareRequestSubmitted}\\n      />\\n\\n      <NotificationsDrawer\\n        isOpen={notificationsDrawerOpen}\\n        onClose={() => setNotificationsDrawerOpen(false)}\\n        notifications={notifications}\\n        onMarkAllAsRead={() => {\\n          setNotifications((prev) => prev.map((n) => ({ ...n, read: true })));\\n        }}\\n        onClearNotifications={() => setNotifications([])}\\n      />\\n\\n      <ProfileModal\\n        isOpen={profileModalOpen}\\n        onClose={() => setProfileModalOpen(false)}\\n        activeCount={reservations.filter((r) => r.status === \'confirmada\').length}\\n      />\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Implement App component with screen management, state persistence and modal coordination\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating App.tsx\", \"toolSummary\":\"Update App.tsx\"}"
      thinking_signature: "\022\312\r\n\307\r\001i\024}\023,\267\346t\356\rbk\\RL\033l\030u\253om0df\307\002a\022T*\266Q\224A\211\177\331\241\360\234\261_H\2420C\245D\333E6Ax\254[\240\027B\250F\307\332I\235\246\354of\016,\235\215\337\352\311\366\2158\276)\b\257?\341?n\f\344\226\316Yf\265\022\3723\227\250\263\357\33286)<\324\355~\216;c\261\340\254\210\350s\f\325\004\332F\211\301h\027\355\242\000|\246\002\374\236\230\3624\211\211.\r:3_\273U/\366a\251Jtm\224\2030\304M|\312s_\253\237\257\027K\266\231\030\335\250?\216w\361>\267\375\227\3750\247zk\000\017\020\tc\270\037\213\255\325S\r\331r\342\036\v\016\021\222g\215i\247\f\016t\020\243\366\224\236\264v\345\250\357\351\301/\024\202\250\270\037\333\243\v\236\302\260?\356\\4S\025\324W\224\322i\270\243\265A\003\245\036\320\n\027\031\211\201\204\235\321\351Q\340\372\315\356#Y[\230\024[\246Vf\203VV\214W|O\006c\035\274\266\362\350b\223\024q\345\033\302\346\376,\335?\373It\037K\036)s\247\353\230\332<\274]\327O\257\232\3734\274q\214Ov9\327Ra\277\322\316X*O9\324cs\020n)H|9\376\203g\337\227\032f\316\336-\233i1,9R!r\336N\346I\356\331\037\f\316\371\341\004\320\255\201;7\254\317\257\256\230\217:\361\312(\344\313b\370&r\216\377\347\336-\322\3108\352y\377\337\035\255\362\215\342W\266\024\221v\267F!\363sD\331\354\376\264\317\374\343v\342\247\256\237\300\351\200\305\f\371\244\300\366\333\365]\255W@\240/\227\254\346f\252\254\251\254\234t\323C\206\"\377\324\364\261e\234\a\2311\336?rt;\366Im\3166\203>\336\237\232\221\306\bMR\353B\222\352\030@\257\2244\033\241\207:\004\230{5\035\206\216\233\372\377W\247\322\032\230\331f\004\2579\372+\275/Q\276|AkC\327a\304\311x\350\027\2415\270D\r\264\203\263?<mW\f\266\b\2746P\024\020\r\366\333:\t\335\346\373Kd0\251O\230\217G5\n_\315\327\247\036\200\032\206\303\332U\265\202G\330\270\215R\275\352\032\005F\231wclT#LW7@\211\232\213\3056\273\3576\255)\244\034\317\r\372\227\235~\222`\357\'0R&\021\233e\336\366\260\213x\251\207o\035\341\304\363}\323\215E\253\251l\201\na\247n\031{\303\f\3112\226\221TM[\323\206\226\303>|8\2654\254\252\036\033\243W\232\263\332\027\363Z\302\336\r\247\375=E[NO\"\213L\263,\300\273\'\357Z\316\304\323\265?\005p\346\'\307\337\255\326Y\022e\3538\263w\272\352O\217)-\316\227U\\\352\222\f\272\350\236\316h\256N\334A\001\317\224E\203\033\276\024\021\316\255\237\204\360mW\254\255\"G\317\217*\373\274t\236\260\233\352S\324\235t\022\325,\005\342\233\254\365J\222\243\376#\333\355\337\20686+0\201\274\267\2614\200\001\355i\223\017\252}\325\245Np~\275\"A\234x\332bhd\025L\355 o\232\225`\035\345\227\017f\273\v\243{\205\240|\274\302\322\335&\367\336\223\351\244 \245\221z\212\275\233\027\205\303\177Ux\257\264m\260-\326\302\211\002\205%\275\231\246\275\266D[8\202\026a\340\271\315\307\203\222J\003<\t\376\335\240\247\031\252\363\213\365\207LP\216K\277[!F\256\371/\216\302O\304\354\306\221\302\203\236O\222\346<\n\tL\032\037&\276\024/k\360\303\236\266\327\357\320\255\270\233R\327\032lj\202\210\340\262\217j\277\236sE\200\016\301\372\307]\331;\005\264\232ywG/\363\232lN\325\027\3020\266\366\3312O\000\nd\037\257x\016\314\350\035\242\342\n\000\345\314*\252\321z\020\005\031k_\vb\362\247\205Je\003\021\250\200-EW\300j\262@A6\352\204>\257\2757X\034\\\265\366\323\265\225\300\336\253Y\b\275\357\356\257U\271\233\267\214\237\213\337|\277\034N\2501\334\376\362wx\246\324\204\247\211{\334\022tU\253s$&\22666:e\230\027\325\212;\323\202\360\241\250\021\367\207\345G\371\233QNJ\257\003\344\266\253;\030|-\"\033\310\326\242\004K\221\2720N\333GX\372\336\220}^\230\207\224\204\207\325o\226 L\305\fx\000|H\2033\376\274\300 \243\217f\\zg\003A\375!o4X\n\343\365\366\266\215\216\331W\345+\004R\364D\331\252}\t[\273%\245\004ws\332r\343\271\272\017\217\372\021\030\245&\332\323\346\340?p\002\235\003>>\031\3420\232]\b`x!\322\306\277;\004o\205\317\241\301\276\'\365\340\023`:+S<\352\211\344im\367[\257\360B{\247\303E6\265\322*\033\372\306c\377\212Io\016lL\004\362\216~\274\0039\275Nm\000b\313\243\204\206Im\n\333\332\243=\204\026(\020\237\3477V\300\a\0278\365\205\317\310$\ab\247\177z]\303\240\216\3650\207\326\314\237\303\272O\3365_\277\267\331\331\223|\313\331\230\273\252w\215\370\347\370\213m$n[\371\221\036\032\302?\a\000\000\272\226\342\201P\260\000u\v\354\023\211\300\340XL\346f:t\215\325\306\325\"9GH\177\254\207\253\026\000\213\246S\361\363\272\315\261\236T=\0064E\375~\202 m\027\016\n\031,\267Kq/\251\320\332$\351\253CE\270\372\361N\266\302\275\355\3449\272\332L\332.Df\034@\306\373\t\037\023\3731F\241\340\266\220\320\206\365\350\300C\371\334m\215U4\243\037E\256\027\316)\201\376(\250\f[\243\302\322\371\277M3\256-\247\244\226\b\246H\247\'}\240\232\223\225Q3\017\"\017\320\32094h\277\3152\215$\236\321\327\354\v,L\365\366\224,\236\241H2\221.w2\017\001B\330\033\000\005g\3738*t\242\343c\001\200>\347H\205p\360\250b\002g>Ax\227\204F\024\251\ri\216\036@\242Q\272\311l\343\256\215\335VT\310\032\026\360\320\313\363\215mDw\355c=\033D\224\261\v\215\367\370=\310\230\353*\031\254\021F\353@\302\334\3752\360z\314m 8-\353\305\361\315\354\326\214\313\367>AM\304\202\264\213\004\020\036\242\331\003^\224\006F\002\347\213Y\234\004$\216p\v8\177\373L\265\372\275\210\017k"

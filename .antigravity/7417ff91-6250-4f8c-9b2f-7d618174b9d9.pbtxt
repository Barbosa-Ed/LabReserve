    tool_calls {
      id: "call_16290"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { UserRole } from \'../types\';\\nimport { PROFESSOR_PROFILE, ADMIN_PROFILE } from \'../data/mockData\';\\n\\ninterface ProfileModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  currentRole: UserRole;\\n  onToggleRole: () => void;\\n  activeCount: number;\\n}\\n\\nexport const ProfileModal: React.FC<ProfileModalProps> = ({\\n  isOpen,\\n  onClose,\\n  currentRole,\\n  onToggleRole,\\n  activeCount,\\n}) => {\\n  if (!isOpen) return null;\\n\\n  const profile = currentRole === \'admin\' ? ADMIN_PROFILE : PROFESSOR_PROFILE;\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 bg-inverse-surface/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4 animate-in fade-in duration-200\\\"\\n      onClick={onClose}\\n    >\\n      <div\\n        className=\\\"bg-surface-container-lowest w-full max-w-md rounded-t-3xl sm:rounded-2xl p-6 shadow-2xl flex flex-col max-h-[90vh] overflow-y-auto animate-in slide-in-from-bottom duration-300\\\"\\n        onClick={(e) => e.stopPropagation()}\\n      >\\n        <div className=\\\"w-12 h-1.5 bg-outline-variant rounded-full mb-4 mx-auto sm:hidden\\\"></div>\\n\\n        {/* Profile Avatar & Title */}\\n        <div className=\\\"flex flex-col items-center text-center pb-4 border-b border-outline-variant/30\\\">\\n          <div className=\\\"relative mb-3\\\">\\n            <img\\n              alt={profile.name}\\n              className=\\\"w-20 h-20 rounded-full object-cover ring-4 ring-primary-fixed shadow-md\\\"\\n              src={profile.avatarUrl}\\n              onError={(e) => {\\n                const target = e.currentTarget;\\n                target.src = \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80\';\\n              }}\\n            />\\n            <span className=\\\"absolute bottom-0 right-0 w-6 h-6 rounded-full bg-secondary ring-2 ring-white flex items-center justify-center text-white text-[12px] font-bold\\\">\\n              \342\234\223\\n            </span>\\n          </div>\\n\\n          <div className=\\\"inline-flex items-center gap-1.5 bg-primary-fixed text-on-primary-fixed px-3 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider mb-1.5\\\">\\n            {currentRole === \'admin\' ? \'Perfil Administrador / DTI\' : \'Perfil Docente / Professor\'}\\n          </div>\\n\\n          <h3 className=\\\"font-headline-sm text-headline-sm text-on-surface font-bold\\\">\\n            {profile.name}\\n          </h3>\\n          <span className=\\\"font-label-md text-label-md text-primary font-semibold mt-0.5\\\">\\n            SIAPE: {profile.siape} \342\200\242 {profile.role}\\n          </span>\\n          <p className=\\\"font-body-sm text-body-sm text-on-surface-variant mt-1\\\">\\n            {profile.department}\\n          </p>\\n          <span className=\\\"font-label-sm text-label-sm text-outline mt-0.5\\\">\\n            {profile.institute}\\n          </span>\\n        </div>\\n\\n        {/* Role Switcher Box */}\\n        <div className=\\\"my-4 p-3.5 bg-primary-fixed/25 rounded-2xl border border-primary/20 flex items-center justify-between\\\">\\n          <div className=\\\"flex flex-col\\\">\\n            <span className=\\\"font-label-sm text-label-sm text-on-surface-variant\\\">Alternar Tipo de Acesso</span>\\n            <span className=\\\"font-label-md text-label-md text-primary font-bold\\\">\\n              {currentRole === \'professor\' ? \'Atualmente: Professor\' : \'Atualmente: Administrador\'}\\n            </span>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onToggleRole}\\n            className=\\\"px-3.5 py-2 rounded-xl bg-primary text-on-primary font-label-sm text-label-sm font-bold flex items-center gap-1.5 shadow-sm active:scale-95 transition-all cursor-pointer\\\"\\n          >\\n            <span className=\\\"material-symbols-outlined text-[16px]\\\">cached</span>\\n            {currentRole === \'professor\' ? \'Mudar p/ Admin\' : \'Mudar p/ Docente\'}\\n          </button>\\n        </div>\\n\\n        <div className=\\\"space-y-3 pb-4\\\">\\n          <div className=\\\"bg-surface-container-low p-3.5 rounded-xl flex items-center justify-between\\\">\\n            <div className=\\\"flex items-center gap-2.5\\\">\\n              <span className=\\\"material-symbols-outlined text-primary text-[20px]\\\">mail</span>\\n              <div className=\\\"flex flex-col\\\">\\n                <span className=\\\"font-label-sm text-label-sm text-on-surface-variant\\\">E-mail Institucional</span>\\n                <span className=\\\"font-body-md text-body-md text-on-surface font-medium truncate max-w-[220px]\\\">\\n                  {profile.email}\\n                </span>\\n              </div>\\n            </div>\\n            <span className=\\\"material-symbols-outlined text-secondary text-[18px]\\\">verified</span>\\n          </div>\\n\\n          <div className=\\\"bg-surface-container-low p-3.5 rounded-xl flex items-center justify-between\\\">\\n            <div className=\\\"flex items-center gap-2.5\\\">\\n              <span className=\\\"material-symbols-outlined text-primary text-[20px]\\\">check_circle</span>\\n              <div className=\\\"flex flex-col\\\">\\n                <span className=\\\"font-label-sm text-label-sm text-on-surface-variant\\\">\\n                  {currentRole === \'admin\' ? \'Total de Salas Ativas\' : \'Minhas Reservas Ativas\'}\\n                </span>\\n                <span className=\\\"font-body-md text-body-md text-on-surface font-bold\\\">\\n                  {currentRole === \'admin\' ? \'6 laborat\303\263rios gerenciados\' : `${activeCount} aulas alocadas`}\\n                </span>\\n              </div>\\n            </div>\\n            <span className=\\\"bg-secondary-container text-on-secondary-container font-label-sm text-label-sm px-2 py-0.5 rounded-full font-bold\\\">\\n              Autenticado\\n            </span>\\n          </div>\\n        </div>\\n\\n        <button\\n          onClick={onClose}\\n          type=\\\"button\\\"\\n          className=\\\"w-full h-12 rounded-xl bg-surface-container text-on-surface font-label-lg text-label-lg hover:bg-surface-container-high transition-colors active:scale-95 font-bold cursor-pointer\\\"\\n        >\\n          Fechar\\n        </button>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update ProfileModal with role switcher and credentials for both Professor and Admin\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ProfileModal.tsx\", \"toolAction\":\"Updating ProfileModal component\", \"toolSummary\":\"Update ProfileModal.tsx\"}"

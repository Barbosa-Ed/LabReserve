            lines {
              text: "    const [endH, endM] = end.split(\':\').map(Number);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let diffMinutes = endH * 60 + endM - (startH * 60 + startM);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (diffMinutes < 0) diffMinutes += 24 * 60;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT

      thinking_signature: "\022\331\025\n\326\025\001i\024}\023\004\260\202\203\327\270f\260\024\327=\003,\n\016\303\fv\177\346\331\251u\fK\371\326\327R^\253@\364T\030\236\301\236\230\347\022go\213B\230\320\273Y\374\325=]\031\"C\276\2442\373\002\307\317\351\203\277\t\261\016\301\233@\271\031#f\340\214\277Q\326\233\236\020i\'\265o\264\337m\222/W=\237\254{\025a\371@,<\362\242>\032\367\342\b\247[\367\212\210\311\365vY\205\327\024\345=\267\256P>\223^K\364\f\037\356\327\225\304\216\215\350F]\333\aI\324J\326\2360|\216VE@\207\220\365\247L\321ws\355!\345f\315\302\2451-h\016\230V\332q.\343\r\367\201\016!\037\275p\274\367\331v\3330_o\273p\222\262\210\216a\317\317\262?\256.\227i\342\333Y:\034\353\343\217\274\307r\025\237:\207W\240\bj\004<\266\203x\276w\255\201\323\037\232\t\342\223\302\232u\370\214z7^\031Zr\254k\342\376\365\344\202N\300\331\343\212_\004O\315\263\375\205\237\346\224\310\263\223.\223G\255\361\350\031q\355\360\202Tk\217Rw\202.\271\236\242Z\322\367\343\026\033\230\214\257\no\310\326MW\354\000\357\313\3201\214\241\303\325/bC\274\336(\253\265\035F\376\225z\bs\362\311[P\021O\265\336\177@x\240Pf$:W\351A\016\a\314\210\346\373tK\310\214;0\250\361|\366\247\033t\373,\035\033\215|Z\340=[\224\346\004\246\2633\037\025u\032#M9\210\016MT\342\336\323\344:\366\006\036/\024\345G\215e\"\027\241\201\343\225\025#9\325C\314\333\\\207\005\330SD]\"!\336\361\205\273\243\205\2275h\251<\245\373\243d4X\346\252\366\025\2046W\363\023F\t\374\025Um:\376\313rH\016\374\241:b\370\302H9\224*5\223q\003\300]\034\204\354sOOE\201\367\270\302n:0\026\372@m\222\317<\270\034RT#\001,\343\027\220\370\202\311\305,\001\347\274G4tE\204\\O\346h\303\306uHK\0012\304\261l7T\210\005\337\261\346\244\vZ\261(\235\364\2322G\214g\020\r\205\240\347 \022_\241`\a\031\326F<?*\020\027\226\327p\2167\215\003o\346\342A\324\376\253O\024b\316R\243\307VOj,O{\323\364^\270\t\337\024\244ROw\216\262#\340x\335\333\370\'@\025\"k\361\266\357\262\376l\334\251\340\210\211\031\242\006J\342\201\003L\330\322\241\320=x\'\034\243\354\323\267\351\251\310r\362\206\216\000\231\337\021\330|\v<\005l\216j\324AW\t\nL\blc%\325\340\304\204\n\270/k\260W\347m\243c$!|%lg-y\356\036\301m\222\301\002\376\374+\354p\241\tS\350\260\351\372\002\216*\221cX\3067\316\346\372\256u\334\020\aLL\\W\241\226\353\315\023T\t/\351\0261\314\300\365\v+\361\306\247\237\342\223\0327\314H\374\v\211\207}\313\352\316~\303\232\243\344\vO(\257M}\006\206G\314\303\343\224\373\241F\353\fKc\346bJ{7\352\230\357\373\220\342.\367\217D\247\247\342\237C\206YH\254\362\326B\236\330\004p\003\206\204\204rg\217\353hU\245\364\342t&5\275\372\260!P^D[ZN\241\022\267YT\"?\303\364\350\177q\210\365G\323w\2322\230\343\037\2622cL\232c\341\300}\327\245\336\026\371\266\254\232\034\325\357\370\023\266\027\333\a\030-\035\373\037!_\335\256\346\016v\305\307,p\222,\306;\t\"\000E\327\375\251?\204\261Q\363\212\244&B\025\325!^\371e\034\214\321M\370\'\0234\250w\266\033\3428\215\v]8~\370\027\263\316\341\246\301\350\367B\350&#\253\335\261\237\211Q\255\276x0r\323\003*\246\243W\373\203\341\bPU\207uV\331\274\316~\327\001,\202\200\262p\2011Q\0376\317\250\375\335\317\330\025\360\355\212]\361\370\331\306\365\255\352\326\304^)\306\215\267\232sa\350\200\022\274x\224s\322\351\3714Sf\331\311\203m\304\224D~L\204eW\334\200N*\333.\261\371vd\344<\213\235\226\346\314$l\343\243\fN\347\371\326K\250\022\306@\2156\212\330\343;\344\242EZk|s\240\344s\263;}\213\367\nVd\335\324&\021\307y\254\356\245\001\363\221\341A\033\\NCyc\355\331\3751?#\326\0312$\a@w^\025\352\373\274\367s\224\203\177\000v`\017\232y\205\001[\323\370k=S\332\343\324\033R\'\334\035\350\246\026p1Z\023\264\365n&\306\204\354B\t\0267\216\300\313\324\323\036<?\002\345\254\202j\220\\\277H\213\017\346\212\006\310P\030~\300\t\257\035pJ\3467\323\006\346\2674\250\345\312m\371\327\t\030\250\311B\364\367\354\351\324\356v0\367{\a&f\366\252h\3049(2\340Z\033J@b\345\265\305\275\370\023\354MKP\322\234?\334\205\230\304\325\r\355\317\2211\344=\217\016c\016\244\257M\317\017N_L\024~$R\023\333A\264\215\311PJ&4$KQ\355\026\235\n\203\036\360\034\304\252p~\nH\3
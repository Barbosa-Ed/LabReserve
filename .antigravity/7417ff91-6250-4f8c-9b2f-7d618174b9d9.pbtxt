        instruction: "import React from \'react\';\n\nexport type NavTab = \'inicio\' | \'nova-reserva\' | \'laboratorios\' | \'historico\';\n\ninterface BottomNavProps {\n  currentTab: NavTab;\n  onSelectTab: (tab: NavTab) => void;\n}\n\nexport const BottomNav: React.FC<BottomNavProps> = ({ currentTab, onSelectTab }) => {\n  return (\n    <nav className=\"fixed bottom-0 inset-x-0 z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-2px_10px_rgba(0,0,0,0.05)] border-t border-outline-variant/30\">\n      <div className=\"max-w-xl mx-auto flex justify-around items-center h-16 px-space-xs\">\n        {/* In\303\255cio */}\n        <button\n          onClick={() => onSelectTab(\'inicio\')}\n          type=\"button\"\n          aria-label=\"In\303\255cio\"\n          className={`flex flex-col items-center justify-center min-w-[64px] min-h-[44px] gap-0.5 transition-colors ${\n            currentTab === \'inicio\'\n              ? \'text-primary font-label-md\'\n              : \'text-on-surface-variant hover:text-on-surface\'\n          }`}\n        >\n          <span\n            className=\"material-symbols-outlined text-[24px]\"\n            style={currentTab === \'inicio\' ? { fontVariationSettings: \"\'FILL\' 1\" } : undefined}\n          >\n            calendar_today\n          </span>\n          <span className=\"font-label-sm text-label-sm\">In\303\255cio</span>\n        </button>\n\n        {/* Reservar (CTA Centralizado) */}\n        <button\n          onClick={() => onSelectTab(\'nova-reserva\')}\n          type=\"button\"\n          aria-label=\"Nova Reserva\"\n          className={`flex flex-col items-center justify-center min-w-[64px] min-h-[44px] gap-0.5 transition-all ${\n            currentTab === \'nova-reserva\'\n              ? \'text-primary font-label-md scale-105\'\n              : \'text-on-surface-variant hover:text-on-surface\'\n          }`}\n        >\n          <div className=\"w-8 h-8 rounded-full bg-primary-container text-on-primary flex items-center justify-center shadow-sm transition-transform active:scale-95\">\n            <span className=\"material-symbols-outlined text-[20px]\">add</span>\n          </div>\n          <span className=\"font-label-sm text-label-sm\">Reservar</span>\n        </button>\n\n        {/* Laborat\303\263rios */}\n        <button\n          onClick={() => onSelectTab(\'laboratorios\')}\n          type=\"button\"\n          aria-label=\"Laborat\303\263rios\"\n          className={`flex flex-col items-center justify-center min-w-[64px] min-h-[44px] gap-0.5 transition-colors ${\n            currentTab === \'laboratorios\'\n              ? \'text-primary font-label-md\'\n              : \'text-on-surface-variant hover:text-on-surface\'\n          }`}\n        >\n          <span\n            className=\"material-symbols-outlined text-[24px]\"\n            style={currentTab === \'laboratorios\' ? { fontVariationSettings: \"\'FILL\' 1\" } : undefined}\n          >\n            desktop_windows\n          </span>\n          <span className=\"font-label-sm text-label-sm\">Laborat\303\263rios</span>\n        </button>\n\n        {/* Hist\303\263rico */}\n        <button\n          onClick={() => onSelectTab(\'historico\')}\n          type=\"button\"\n          aria-label=\"Hist\303\263rico de Reservas\"\n          className={`flex flex-col items-center justify-center min-w-[64px] min-h-[44px] gap-0.5 transition-colors ${\n            currentTab === \'historico\'\n              ? \'text-primary font-label-md\'\n              : \'text-on-surface-variant hover:text-on-surface\'\n          }`}\n        >\n          <span\n            className=\"material-symbols-outlined text-[24px]\"\n            style={currentTab === \'historico\' ? { fontVariationSettings: \"\'FILL\' 1\" } : undefined}\n          >\n            schedule\n          </span>\n          <span className=\"font-label-sm text-label-sm\">Hist\303\263rico</span>\n        </button>\n      </div>\n    </nav>\n  );\n};\n"

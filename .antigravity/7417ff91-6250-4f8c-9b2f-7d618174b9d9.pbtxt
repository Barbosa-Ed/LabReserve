sName=\"w-full h-12 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 shadow-sm active:bg-primary-container transition-all cursor-pointer\"\n            onClick={handleAddToCalendar}\n            type=\"button\"\n          >\n            <span className=\"material-symbols-outlined text-[20px]\">event</span>\n            Adicionar \303\240 Agenda (Google / Outlook)\n          </button>\n\n          <button\n            className=\"w-full h-12 rounded-lg bg-surface-container-highest text-on-surface font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 hover:bg-surface-dim transition-all cursor-pointer\"\n            onClick={handleShareTicket}\n            type=\"button\"\n          >\n            <span className=\"material-symbols-outlined text-[20px]\">share</span>\n            Compartilhar com os Alunos / Baixar PDF\n          </button>\n\n          <button\n            className=\"w-full py-space-sm text-center text-primary font-label-md text-label-md font-bold hover:underline transition-all cursor-pointer\"\n            onClick={onCancel}\n            type=\"button\"\n          >\n            Voltar para a P\303\241gina Inicial\n          </button>\n        </div>\n      </div>\n\n      {/* Micro-Toast for copied feedback */}\n      <div\n        className={`fixed bottom-6 inset-x-4 max-w-xs mx-auto bg-inverse-surface text-inverse-on-surface px-space-md py-space-sm rounded-full shadow-lg flex items-center justify-center gap-2 transition-opacity duration-300 z-50 ${\n          toastMessage ? \'opacity-100\' : \'opacity-0 pointer-events-none\'\n        }`}\n        id=\"toast-copied\"\n      >\n        <span className=\"material-symbols-outlined text-[18px] text-secondary-fixed\">check</span>\n        <span className=\"font-body-sm text-body-sm\">{toastMessage}</span>\n      </div>\n    </div>\n  );\n};\n"

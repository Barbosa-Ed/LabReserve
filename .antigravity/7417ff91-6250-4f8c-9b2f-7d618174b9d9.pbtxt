      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { UserRole } from \'../types\';\\nimport { PROFESSOR_PROFILE, ADMIN_PROFILE } from \'../data/mockData\';\\n\\ninterface HeaderProps {\\n  subtitle: string;\\n  currentRole: UserRole;\\n  onToggleRole: () => void;\\n  showBack?: boolean;\\n  onBack?: () => void;\\n  onOpenNotifications?: () => void;\\n  onOpenProfile?: () => void;\\n  unreadCount?: number;\\n  currentTab: string;\\n  onSelectTab: (tab: any) => void;\\n}\\n\\nexport const Header: React.FC<HeaderProps> = ({\\n  subtitle,\\n  currentRole,\\n  onToggleRole,\\n  showBack = false,\\n  onBack,\\n  onOpenNotifications,\\n  onOpenProfile,\\n  unreadCount = 2,\\n  currentTab,\\n  onSelectTab,\\n}) => {\\n  const profile = currentRole === \'admin\' ? ADMIN_PROFILE : PROFESSOR_PROFILE;\\n\\n  return (\\n    <header className=\\\"fixed top-0 inset-x-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] pt-safe border-b border-outline-variant/20\\\">\\n      <div className=\\\"max-w-7xl mx-auto h-16 px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4\\\">\\n        {/* Left: Brand & Back button */}\\n        <div className=\\\"flex items-center gap-3\\\">\\n          {showBack && (\\n            <button\\n              aria-label=\\\"Voltar\\\"\\n              className=\\\"w-10 h-10 -ml-2 rounded-full flex items-center justify-center text-on-surface hover:text-primary hover:bg-surface-container-high transition-colors active:scale-95\\\"\\n              onClick={onBack}\\n              type=\\\"button\\\"\\n            >\\n              <span className=\\\"material-symbols-outlined text-[24px]\\\">arrow_back</span>\\n            </button>\\n          )}\\n\\n          <div\\n            className=\\\"flex items-center gap-2.5 cursor-pointer select-none\\\"\\n            onClick={() => onSelectTab(currentRole === \'admin\' ? \'admin-pedidos\' : \'inicio\')}\\n          >\\n            <img\\n              alt=\\\"LabReserve Logo\\\"\\n              className=\\\"h-8 w-auto object-contain shrink-0\\\"\\n              src={profile.logoUrl}\\n              onError={(e) => {\\n                const target = e.currentTarget;\\n                target.style.display = \'none\';\\n              }}\\n            />\\n            <div className=\\\"flex flex-col min-w-0\\\">\\n              <span className=\\\"font-headline-sm text-headline-sm text-primary leading-none font-black tracking-tight flex items-center gap-1.5\\\">\\n                LabReserve\\n                <span className={`text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider ${\\n                  currentRole === \'admin\'\\n                    ? \'bg-primary-container text-on-primary\'\\n                    : \'bg-surface-container text-on-surface-variant\'\\n                }`}>\\n                  {currentRole === \'admin\' ? \'Admin\' : \'Docente\'}\\n                </span>\\n              </span>\\n              <span className=\\\"font-label-sm text-label-sm text-on-surface-variant leading-none mt-1 truncate max-w-[200px]\\\">\\n                {subtitle}\\n              </span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Center: Desktop Navigation Links (Visible on tablets and desktop browsers) */}\\n        <nav className=\\\"hidden md:flex items-center gap-1 lg:gap-2\\\">\\n          {currentRole === \'professor\' ? (\\n            <>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onSelectTab(\'inicio\')}\\n                className={`px-3 py-1.5 rounded-xl font-label-md text-label-md font-semibold transition-all cursor-pointer ${\\n                  currentTab === \'inicio\'\\n                    ? \'bg-primary text-on-primary shadow-sm\'\\n                    : \'text-on-surface-variant hover:text-on-surface hover:bg-surface-container\'\\n                }`}\\n              >\\n                In\303\255cio\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onSelectTab(\'nova-reserva\')}\\n                className={`px-3 py-1.5 rounded-xl font-label-md text-label-md font-semibold transition-all cursor-pointer ${\\n                  currentTab === \'nova-reserva\'\\n                    ? \'bg-primary text-on-primary shadow-sm\'\\n                    : \'text-on-surface-variant hover:text-on-surface hover:bg-surface-container\'\\n                }`}\\n              >\\n                Pedir Sala\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onSelectTab(\'laboratorios\')}\\n                className={`px-3 py-1.5 rounded-xl font-label-md text-label-md font-semibold transition-all cursor-pointer ${\\n                  currentTab === \'laboratorios\'\\n                    ? \'bg-primary text-on-primary shadow-sm\'\\n                    : \'text-on-surface-variant hover:text-on-surface hover:bg-surface-container\'\\n                }`}\\n              >\\n                Grade de Salas\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onSelectTab(\'historico\')}\\n                className={`px-3 py-1.5 rounded-xl font-label-md text-label-md font-semibold transition-all cursor-pointer ${\\n                  currentTab === \'historico\'\\n                    ? \'bg-primary text-on-primary shadow-sm\'\\n                    : \'text-on-surface-variant hover:text-on-surface hover:bg-surface-container\'\\n                }`}\\n              >\\n                Minhas Reservas\\n              </button>\\n            </>\\n          ) : (\\n            <>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onSelectTab(\'admin-pedidos\')}\\n                className={`px-3 py-1.5 rounded-xl font-label-md text-label-md font-semibold transition-all cursor-pointer flex items-center gap-1.5 ${\\n                  currentTab === \'admin-pedidos\'\\n                    ? \'bg-primary text-on-primary shadow-sm\'\\n                    : \'text-on-surface-variant hover:text-on-surface hover:bg-surface-container\'\\n                }`}\\n              >\\n                <span className=\\\"material-symbols-outlined text-[18px]\\\">how_to_reg</span>\\n                Moderar Pedidos\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onSelectTab(\'admin-salas\')}\\n                className={`px-3 py-1.5 rounded-xl font-label-md text-label-md font-semibold transition-all cursor-pointer flex items-center gap-1.5 ${\\n                  currentTab === \'admin-salas\'\\n                    ? \'bg-primary text-on-primary shadow-sm\'\\n                    : \'text-on-surface-variant hover:text-on-surface hover:bg-surface-container\'\\n                }`}\\n              >\\n                <span className=\\\"material-symbols-outlined text-[18px]\\\">meeting_room</span>\\n                Gerenciar Salas (CRUD)\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onSelectTab(\'historico\')}\\n                className={`px-3 py-1.5 rounded-xl font-label-md text-label-md font-semibold transition-all cursor-pointer flex items-center gap-1.5 ${\\n                  currentTab === \'historico\'\\n                    ? \'bg-primary text-on-primary shadow-sm\'\\n                    : \'text-on-surface-variant hover:text-on-surface hover:bg-surface-container\'\\n                }`}\\n              >\\n                <span className=\\\"material-symbols-outlined text-[18px]\\\">history</span>\\n                Hist\303\263rico Geral\\n              </button>\\n            </>\\n          )}\\n        </nav>\\n\\n        {/* Right: Role Switcher & User Profile */}\\n        <div className=\\\"flex items-center gap-2 sm:gap-3\\\">\\n          {/* Role Toggle Button */}\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onToggleRole}\\n            title={`Alternar para vis\303\243o de ${currentRole === \'professor\' ? \'Administrador\' : \'Professor\'}`}\\n            className=\\\"flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-sm text-label-sm font-bold border border-outline-variant/30 active:scale-95 transition-all cursor-pointer\\\"\\n          >\\n            <span className=\\\"material-symbols-outlined text-[16px] text-primary\\\">swap_horiz</span>\\n            <span className=\\\"hidden sm:inline\\\">\\n              {currentRole === \'professor\' ? \'Mudar p/ Admin\' : \'Mudar p/ Docente\'}\\n            </span>\\n            <span className=\\\"sm:hidden\\\">\\n              {currentRole === \'professor\' ? \'Admin\' : \'Docente\'}\\n            </span>\\n          </button>\\n\\n          {/* Notifications Trigger */}\\n          <button\\n            aria-label=\\\"Notifica\303\247\303\265es\\\"\\n            className=\\\"relative w-10 h-10 rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors cursor-pointer\\\"\\n            onClick={onOpenNotifications}\\n            type=\\\"button\\\"\\n          >\\n            <span className=\\\"material-symbols-outlined text-[22px]\\\">notifications</span>\\n            {unreadCount > 0 && (\\n              <span className=\\\"absolute top-2 right-2 w-2.5 h-2.5 rounded-full bg-secondary ring-2 ring-surface animate-pulse\\\" />\\n            )}\\n          </button>\\n\\n          {/* Profile Trigger */}\\n          <button\\n            aria-label=\\\"Perfil do Usu\303\241rio\\\"\\n            className=\\\"flex items-center gap-2 rounded-full p-0.5 hover:ring-2 hover:ring-primary-container transition-all active:scale-95 cursor-pointer\\\"\\n            onClick={onOpenProfile}\\n            type=\\\"button\\\"\\n          >\\n            <img\\n              alt={profile.name}\\n              className=\\\"w-8 h-8 rounded-full object-cover ring-2 ring-primary-fixed shadow-sm\\\"\\n              src={profile.avatarUrl}\\n              onError={(e) => {\\n                const target = e.currentTarget;\\n                target.src = \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80\';\\n              }}\\n            />\\n            <span className=\\\"hidden xl:inline text-xs font-bold text-on-surface\\\">\\n              {profile.name.split(\' \')[0]}\\n            </span>\\n          </button>\\n        </div>\\n      </div>\\n    </header>\\n  );\\n};\\n\", \"Description\":\"Update Header component with desktop navigation links and seamless Role Switcher\", \"Overwrite\":true, \"TargetFile\":\"/src/components/Header.tsx\", \"toolAction\":\"Updating Header component\", \"toolSummary\":\"Update Header.tsx\"}"
      thinking_signature: "\022\313\n\n\310\n\001i\024}\023\241P\234\312\376\260\033\320k.\200A\266\337\233%\036\344i\314\203\034rTZ$<\2537\237\242g\244\3727fJ\036\275\003\'\315\033+\247Q\275S\214\233\330\326\350\217rz>g&Y\244(\325\v\030\204\037\341]\364\204\242\367\251\323\002\225\315\345\vz\261\0275\277\215$\004t\341\345ku\373\232W\241,\377\341/Exq\303\204\340\314\376j\225n\373\200\355R\t\375\2060\020\033\375\037\251\367\r\202\367\277\231\005F/6\202\305h\244a\\8\346\000e\257\bo\256T\372\326\266&P1,KL\372d\320+\006\300\257\227/u\a\037|\356#7\347\330\222{\300\310\376\231\344\224\001C\345\313O\030\314\362\002\335H#9\340\324\034Q\245j/\b\016\177T5u~S\356\234G\226\323H\a5)B\036\016T\227\035\'\020\fO\2429J5\303p]^[\205\271^\322m%F8i-=>\213\037\001\357\f\244\306&\f\231\311\204\275\254<\002GK-!U[y\320>\260D>S.\241FfF\223\264\343i\026G\331\341\032\264\345\362x\333\253\357\002\210\252\323\232U\302L\342\360\235\352\322\177tl\227\210\304\303Kj\000\211X\271\242\003\305X\236h\234|\220(p\213\225\325\276\263\002\272\264m!\273\267\020\016\216\263\367\026\277\027\313\3716\310\256\003\355\252\035\245\361\231e\212\357\"0g\377>f\316{\003\314\227\037\"\300,\231\005\2542\003N\212\324\017ahn4J\211I\263`\245\b\0218\004\277\222\366\a\322\214_\246x\321\321(\315\350\256\214:<\006Sg\201\375\330\"?\314q\021+ky\t\2437M\"\314L\312\365\342\241w\'\264\a1\312\006\b9\236\246x@\223\210S\006VY\235\216Jd\363\312\207\277b\337%\373\277k\024\207\301\2232\214Z\r\321G\312\314\210\304\231\231]\373\333\252rUBf\363\027\347\030\021\310\343\346\365T\335W7\363|\341{n\241~\242\220\2411*\264\3311\327_\221\313dB\322V\232\301\304\276\264t\000\233[\317\337@:\230\264hY\254\225\327\037\366\307)B\021s\r\016\214\211\221(\333u1\304\031\237\220\252\254\343\025\3043\001JK\263\354_\321\237\021\313\224z\017\360\345S\216\377\226H\317\327\002,\226\371\036\217\335S7\352\307\340b\b\211\270\000\a\343z\305\277Y\241\016!\351\245>L\317\227Dl\302\311\177/\027\200\330\255\353\240\351\302\016\002]\037}\341\342\272\253\233\177x\377\305\24
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export async function shareReservationJpg(res: Reservation): Promise<void> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const dataUrl = await generateReservationJpgDataUrl(res);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const response = await fetch(dataUrl);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const blob = await response.blob();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const room = res.assignedLabCode || \'SALA\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const file = new File([blob], `comprovante-reserva-${room}.jpg`, { type: \'image/jpeg\' });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (navigator.canShare && navigator.canShare({ files: [file] })) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    try {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      await navigator.share({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        files: [file],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        title: `Reserva Sala ${room} - ${res.subject}`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: `Comprovante oficial de aloca\303\247\303\243o de sala ${room} (${res.assignedLocation || \'Campus\'}) para a aula de ${res.subject}.`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } catch {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // User cancelled share or not supported"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {

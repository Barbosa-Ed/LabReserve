    content: "<!DOCTYPE html>\n\n<html lang=\"pt-BR\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_tab\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"secondary-fixed-dim\": \"#4edea3\", \"secondary\": \"#006c49\", \"background\": \"#faf8ff\", \"surface-dim\": \"#d2d9f4\", \"on-tertiary-fixed-variant\": \"#653e00\", \"on-secondary-fixed-variant\": \"#005236\", \"tertiary-container\": \"#825100\", \"tertiary-fixed-dim\": \"#ffb95f\", \"on-secondary\": \"#ffffff\", \"secondary-container\": \"#6cf8bb\", \"on-background\": \"#131b2e\", \"on-tertiary\": \"#ffffff\", \"outline-variant\": \"#c4c5d7\", \"on-tertiary-fixed\": \"#2a1700\", \"on-tertiary-container\": \"#ffcb8f\", \"inverse-on-surface\": \"#eef0ff\", \"on-primary-container\": \"#cad3ff\", \"surface-bright\": \"#faf8ff\", \"on-secondary-fixed\": \"#002113\", \"secondary-fixed\": \"#6ffbbe\", \"on-surface-variant\": \"#434655\", \"on-primary-fixed-variant\": \"#0039b5\", \"primary-container\": \"#1d4ed8\", \"tertiary\": \"#623c00\", \"surface-container\": \"#eaedff\", \"surface\": \"#faf8ff\", \"on-secondary-container\": \"#00714d\", \"outline\": \"#747686\", \"surface-tint\": \"#2151da\", \"surface-container-low\": \"#f2f3ff\", \"surface-variant\": \"#dae2fd\", \"on-error\": \"#ffffff\", \"primary\": \"#0037b0\", \"on-primary\": \"#ffffff\", \"error-container\": \"#ffdad6\", \"primary-fixed-dim\": \"#b7c4ff\", \"primary-fixed\": \"#dce1ff\", \"tertiary-fixed\": \"#ffddb8\", \"surface-container-highest\": \"#dae2fd\", \"inverse-surface\": \"#283044\", \"on-primary-fixed\": \"#001551\", \"surface-container-high\": \"#e2e7ff\", \"inverse-primary\": \"#b7c4ff\", \"error\": \"#ba1a1a\", \"on-surface\": \"#131b2e\", \"on-error-container\": \"#93000a\", \"surface-container-lowest\": \"#ffffff\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"margin\": \"1rem\", \"space-md\": \"1rem\", \"space-xl\": \"2rem\", \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"space-lg\": \"1.5rem\", \"space-sm\": \"0.5rem\" }, fontFamily: { \"body-sm\": [\"Plus Jakarta Sans\"], \"display-lg\": [\"Plus Jakarta Sans\"], \"headline-md\": [\"Plus Jakarta Sans\"], \"label-md\": [\"Plus Jakarta Sans\"], \"title-md\": [\"Plus Jakarta Sans\"], \"label-lg\": [\"Plus Jakarta Sans\"], \"body-md\": [\"Plus Jakarta Sans\"], \"headline-sm\": [\"Plus Jakarta Sans\"], \"headline-lg\": [\"Plus Jakarta Sans\"], \"label-sm\": [\"Plus Jakarta Sans\"], \"body-lg\": [\"Plus Jakarta Sans\"] }, fontSize: { \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"display-lg\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }], \"headline-md\": [\"20px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"600\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"title-md\": [\"16px\", { \"lineHeight\": \"22px\", \"fontWeight\": \"600\" }], \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"headline-lg\": [\"24px\", { \"lineHeight\": \"32px\", \"letterSpacing\": \"-0.015em\", \"fontWeight\": \"700\" }], \"label-sm\": [\"11px\", { \"lineHeight\": \"14px\", \"letterSpacing\": \"0.03em\", \"fontWeight\": \"600\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }] } } } };</script><style>@layer base{html,body{width:100%;min-height:100%;margin:0;padding:0;}body{overscroll-behavior-y:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 inset-x-0 z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] pt-safe\"><div class=\"h-16 px-gutter flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><img alt=\"LabReserve Logo\" class=\"h-8 w-auto object-contain\" src=\"https://lh3.googleusercontent.com/aida/AEtjO1Xzpg_lS837oxSWCBlplqPFSe1nt2DTJ1AIdxqjatdVzRrR7i6J-ArBIpCR6ujvUTgfC9O5dPLrB8ZV1ZJYL7ctGQTOoSPZMHulQoRSa17Fv4mVDg6guuDd_z4Q1-Am2nDV7JbPb4CYe7bfR9ynMp_HVCn7f_nOCgeOPDsxkItcLA-B5UshpN73NcvRVRgyEoqgpzWF1HoK1mVzTQUgkBBPLuo0iR77yd1E9e6Y0-C7UqN-1DzRzCOViMI\"/><div class=\"flex flex-col\"><span class=\"font-headline-sm text-headline-sm text-primary leading-none\">LabReserve</span><span class=\"font-label-sm text-label-sm text-on-surface-variant leading-none mt-0.5\">In\303\255cio</span></div></div><div class=\"flex items-center gap-space-sm\"><button aria-label=\"Notifica\303\247\303\265es\" class=\"w-11 h-11 flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors\"><span class=\"material-symbols-outlined text-[24px]\">notifications</span></button><div class=\"flex items-center gap-space-xs\"><img alt=\"Profile\" class=\"w-8 h-8 rounded-full object-cover ring-2 ring-primary-fixed\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDlKNP45fFEPE8-tOAuDHEAj7iXJe0uFkM0jJkpZZktmdQxE9Q5wR09uoj-iU91RMcE6EW65ZtNxwbWhB7z9fP35KgI3U0LIZZjUGiX0E-wi2LNVMQUr5DgVmv3OLE86iR86ThM3mCcGSMvrrY_UNBoVX0wtWTuQhAqyA8Pq2pNpiMSkyaRCeY6BG5rAxxrq-yc-kcdMZmUW3LA5bhgUxSrjH75se-quNWoZIXqpZaP_mvT7D4Fs75_zg\"/></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full pt-16 pb-24 bg-surface\"><div class=\"flex flex-col w-full pb-8\">\n<!-- Top Greeting & Department Context -->\n<section class=\"px-gutter pt-4 pb-2\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex flex-col\">\n<div class=\"flex items-center gap-1.5\">\n<h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight\">Ol\303\241, Prof. Andr\303\251</h1>\n<span class=\"text-xl animate-bounce\">\360\237\221\213</span>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">school</span>\n          Departamento de Ci\303\252ncia da Computa\303\247\303\243o\n        </p>\n</div>\n<div class=\"w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-primary shadow-sm relative\">\n<span class=\"material-symbols-outlined text-[20px]\">calendar_today</span>\n<span class=\"absolute top-2 right-2 w-2 h-2 rounded-full bg-secondary\"></span>\n</div>\n</div>\n</section>\n<!-- Metric Counters Bento Strip -->\n<section class=\"px-gutter py-3\">\n<div class=\"grid grid-cols-3 gap-2.5\">\n<div class=\"bg-surface-container-lowest rounded-xl p-3 flex flex-col justify-between shadow-sm relative overflow-hidden\">\n<div class=\"absolute -right-2 -bottom-2 w-12 h-12 bg-primary/5 rounded-full pointer-events-none\"></div>\n<span class=\"material-symbols-outlined text-primary text-[20px]\">event_available</span>\n<div class=\"mt-2\">\n<span class=\"font-headline-lg text-headline-lg text-on-surface block leading-tight\">3</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant line-clamp-1\">Reservas Ativas</span>\n</div>\n</div>\n<div class=\"bg-surface-container-lowest rounded-xl p-3 flex flex-col justify-between shadow-sm relative overflow-hidden\">\n<div class=\"absolute -right-2 -bottom-2 w-12 h-12 bg-tertiary-fixed/30 rounded-full pointer-events-none\"></div>\n<span class=\"material-symbols-outlined text-tertiary-container text-[20px]\">pending_actions</span>\n<div class=\"mt-2\">\n<span class=\"font-headline-lg text-headline-lg text-on-surface block leading-tight\">1</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant line-clamp-1\">Pendente TI</span>\n</div>\n</div>\n<div class=\"bg-surface-container-lowest rounded-xl p-3 flex flex-col justify-between shadow-sm relative overflow-hidden\">\n<div class=\"absolute -right-2 -bottom-2 w-12 h-12 bg-secondary-container/40 rounded-full pointer-events-none\"></div>\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">verified</span>\n<div class=\"mt-2\">\n<span class=\"font-headline-lg text-headline-lg text-secondary block leading-tight\">98%</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant line-clamp-1\">Taxa de Aprov.</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Next Class Spotlight Hero Card -->\n<section class=\"px-gutter py-2\">\n<div class=\"flex items-center justify-between mb-2\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"flex h-2 w-2 rounded-full bg-secondary animate-pulse\"></span>\n<h2 class=\"font-title-md text-title-md text-on-surface\">Pr\303\263xima Aula Agendada</h2>\n</div>\n<span class=\"font-label-sm text-label-sm text-primary font-semibold\">Hoje</span>\n</div>\n<div class=\"bg-surface-container-lowest rounded-2xl p-4 shadow-md flex flex-col gap-3 relative overflow-hidden\">\n<!-- Decorative Backdrop Geometry -->\n<div class=\"absolute -top-12 -right-12 w-32 h-32 bg-primary-fixed/20 rounded-full pointer-events-none blur-xl\"></div>\n<!-- Time and Status Header -->\n<div class=\"flex items-center justify-between relative z-10\">\n<div class=\"flex items-center gap-1.5 bg-primary-fixed text-on-primary-fixed px-2.5 py-1 rounded-full\">\n<span class=\"material-symbols-outlined text-[16px]\">schedule</span>\n<span class=\"font-label-md text-label-md\">14:00 - 16:30</span>\n</div>\n<span class=\"inline-flex items-center gap-1 bg-secondary-container/60 text-on-secondary-container px-2.5 py-0.5 rounded-full font-label-sm text-label-sm font-semibold\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-secondary\"></span>\n          Confirmada\n        </span>\n</div>\n<!-- Class & Lab Metadata -->\n<div class=\"relative z-10\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold tracking-tight\">Estrutura de Dados e Algoritmos</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant flex items-center gap-1 mt-1\">\n<span class=\"material-symbols-outlined text-[18px] text-primary\">computer</span>\n          Laborat\303\263rio 04 <span class=\"text-outline-variant\">\342\200\242</span> Pr\303\251dio Tecnol\303\263gico 2\n        </p>\n</div>\n<!-- Capacity & Tech Stack Pills -->\n<div class=\"flex flex-wrap items-center gap-1.5 relative z-10 pt-1\">\n<span class=\"inline-flex items-center gap-1 bg-surface-container text-on-surface-variant px-2.5 py-1 rounded-lg font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[14px]\">groups</span>\n          35 Alunos\n        </span>\n<span class=\"inline-flex items-center gap-1 bg-surface-container text-on-surface-variant px-2.5 py-1 rounded-lg font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[14px]\">code</span>\n          VS Code \342\200\242 GCC \342\200\242 Git\n        </span>\n</div>\n<!-- QR Code Access Action Button -->\n<div class=\"pt-2 relative z-10\">\n<button class=\"w-full bg-primary hover:bg-on-primary-fixed-variant active:scale-[0.99] transition-all text-on-primary h-12 rounded-xl flex items-center justify-center gap-2 font-label-lg text-label-lg shadow-sm\" id=\"btn-qr-access\">\n<span class=\"material-symbols-outlined text-[20px]\">qr_code_2</span>\n          Ver C\303\263digo de Acesso / QR\n        </button>\n</div>\n</div>\n</section>\n<!-- Quick Actions Grid -->\n<section class=\"px-gutter py-3\">\n<h2 class=\"font-title-md text-title-md text-on-surface mb-2.5\">A\303\247\303\265es R\303\241pidas</h2>\n<div class=\"flex flex-col gap-2\">\n<!-- Main Primary Action -->\n<button class=\"w-full bg-primary-container text-on-primary p-3.5 rounded-xl flex items-center justify-between shadow-sm active:scale-[0.99] transition-transform\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-lg bg-surface-container-lowest/20 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[24px]\">add_circle</span>\n</div>\n<div class=\"flex flex-col text-left\">\n<span class=\"font-label-lg text-label-lg leading-tight font-bold\">Fazer Nova Reserva</span>\n<span class=\"font-label-sm text-label-sm text-on-primary-container\">Alocar computadores ou salas tem\303\241ticas</span>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n</button>\n<!-- Secondary Quick Actions (2-column layout) -->\n<div class=\"grid grid-cols-2 gap-2\">\n<button class=\"bg-surface-container-lowest text-on-surface p-3 rounded-xl flex flex-col justify-between shadow-sm text-left h-24 hover:bg-surface-container-low transition-colors\">\n<div class=\"w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[18px]\">grid_view</span>\n</div>\n<span class=\"font-label-md text-label-md line-clamp-2\">Consultar Grade de Labs</span>\n</button>\n<button class=\"bg-surface-container-lowest text-on-surface p-3 rounded-xl flex flex-col justify-between shadow-sm text-left h-24 hover:bg-surface-container-low transition-colors\">\n<div class=\"w-8 h-8 rounded-lg bg-tertiary-container/10 text-tertiary-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[18px]\">build</span>\n</div>\n<span class=\"font-label-md text-label-md line-clamp-2\">Solicitar Instala\303\247\303\243o de Software</span>\n</button>\n</div>\n</div>\n</section>\n<!-- Upcoming Reservations List -->\n<section class=\"px-gutter py-2 flex flex-col gap-2.5\">\n<div class=\"flex items-center justify-between\">\n<h2 class=\"font-title-md text-title-md text-on-surface\">Suas Pr\303\263ximas Reservas</h2>\n<a class=\"font-label-sm text-label-sm text-primary font-semibold hover:underline\" href=\"#\">Ver todas (3)</a>\n</div>\n<!-- Reservation 1: Web III -->\n<div class=\"bg-surface-container-lowest rounded-xl p-3.5 shadow-sm flex flex-col gap-2.5\">\n<div class=\"flex items-start justify-between gap-2\">\n<div class=\"flex flex-col\">\n<h4 class=\"font-title-md text-title-md text-on-surface font-semibold\">Programa\303\247\303\243o Web III</h4>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"material-symbols-outlined text-[15px] text-outline\">desktop_mac</span>\n            Lab 02 (Macintosh Studio)\n          </span>\n</div>\n<span class=\"inline-flex items-center gap-1 bg-secondary-container/50 text-on-secondary-container px-2 py-0.5 rounded-full font-label-sm text-label-sm font-semibold\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-secondary\"></span>\n          Confirmada\n        </span>\n</div>\n<div class=\"flex items-center justify-between pt-1 text-on-surface-variant\">\n<div class=\"flex items-center gap-2\">\n<div class=\"flex items-center gap-1 text-primary bg-primary-fixed/30 px-2 py-0.5 rounded font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[14px]\">calendar_month</span>\n            24/Out\n          </div>\n<span class=\"font-label-sm text-label-sm\">08:00 - 10:00</span>\n</div>\n<button aria-label=\"Detalhes\" class=\"w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:text-primary transition-colors\">\n<span class=\"material-symbols-outlined text-[18px]\">chevron_right</span>\n</button>\n</div>\n</div>\n<!-- Reservation 2: IA & PyTorch (Pending IT) -->\n<div class=\"bg-surface-container-lowest rounded-xl p-3.5 shadow-sm flex flex-col gap-2.5\">\n<div class=\"flex items-start justify-between gap-2\">\n<div class=\"flex flex-col\">\n<h4 class=\"font-title-md text-title-md text-on-surface font-semibold\">Intelig\303\252ncia Artificial</h4>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"material-symbols-outlined text-[15px] text-outline\">memory</span>\n            Lab 05 (GPU Workstations)\n          </span>\n</div>\n<span class=\"inline-flex items-center gap-1 bg-tertiary-fixed text-on-tertiary-fixed-variant px-2 py-0.5 rounded-full font-label-sm text-label-sm font-semibold\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary-container animate-pulse\"></span>\n          Aguardando TI\n        </span>\n</div>\n<!-- TI Installation Details Callout -->\n<div class=\"bg-surface-container-low rounded-lg px-2.5 py-1.5 flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-tertiary-container text-[16px]\">hourglass_top</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Chamado #4892: Instala\303\247\303\243o PyTorch 2.3 + CUDA</span>\n</div>\n<div class=\"flex items-center justify-between pt-0.5 text-on-surface-variant\">\n<div class=\"flex items-center gap-2\">\n<div class=\"flex items-center gap-1 text-primary bg-primary-fixed/30 px-2 py-0.5 rounded font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[14px]\">calendar_month</span>\n            26/Out\n          </div>\n<span class=\"font-label-sm text-label-sm\">10:00 - 12:00</span>\n</div>\n<button aria-label=\"Detalhes\" class=\"w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:text-primary transition-colors\">\n<span class=\"material-symbols-outlined text-[18px]\">chevron_right</span>\n</button>\n</div>\n</div>\n</section>\n<!-- Interactive Sheet for Access QR Modal -->\n<div class=\"fixed inset-0 z-50 bg-inverse-surface/40 backdrop-blur-sm hidden items-end justify-center\" id=\"qr-modal\">\n<div class=\"bg-surface-container-lowest w-full max-w-md rounded-t-3xl p-6 shadow-xl flex flex-col items-center text-center animate-in slide-in-from-bottom duration-200\">\n<div class=\"w-12 h-1.5 bg-outline-variant rounded-full mb-4\"></div>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Laborat\303\263rio 04 - Acesso R\303\241pido</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 mb-4\">Apresente este c\303\263digo no leitor da porta do laborat\303\263rio para desbloqueio.</p>\n<!-- Vector QR Representation -->\n<div class=\"p-4 bg-surface rounded-2xl shadow-inner mb-4 flex flex-col items-center\">\n<svg class=\"w-48 h-48 text-on-surface\" fill=\"currentColor\" viewbox=\"0 0 100 100\">\n<path d=\"M10 10h30v30h-30zM15 15v20h20v-20zM22 22h6v6h-6zM60 10h30v30h-30zM65 15v20h20v-20zM72 22h6v6h-6zM10 60h30v30h-30zM15 65v20h20v-20zM22 72h6v6h-6zM48 10h4v20h-4zM48 38h4v10h-4zM10 48h20v4h-20zM38 48h10v4h-10zM60 48h15v4h-15zM82 48h8v4h-8zM48 60h4v30h-4zM60 60h8v8h-8zM76 60h14v8h-14zM68 76h8v14h-8zM84 76h6v14h-6z\"></path>\n</svg>\n<span class=\"font-headline-sm text-headline-sm font-mono tracking-widest text-primary mt-2\">LR-4092-CC</span>\n</div>\n<p class=\"font-label-sm text-label-sm text-secondary font-semibold mb-4 flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px]\">check_circle</span> V\303\241lido at\303\251 16:45 de Hoje\n      </p>\n<button class=\"w-full bg-surface-container text-on-surface h-12 rounded-xl font-label-lg text-label-lg hover:bg-surface-container-high transition-colors\" id=\"btn-close-qr\">\n        Fechar\n      </button>\n</div>\n</div>\n</div>\n<script>\n  (function() {\n    const qrBtn = document.getElementById(\'btn-qr-access\');\n    const qrModal = document.getElementById(\'qr-modal\');\n    const closeBtn = document.getElementById(\'btn-close-qr\');\n\n    if (qrBtn && qrModal && closeBtn) {\n      qrBtn.addEventListener(\'click\', () => {\n        qrModal.classList.remove(\'hidden\');\n        qrModal.classList.add(\'flex\');\n      });\n\n      const closeModal = () => {\n        qrModal.classList.add(\'hidden\');\n        qrModal.classList.remove(\'flex\');\n      };\n\n      closeBtn.addEventListener(\'click\', closeModal);\n      qrModal.addEventListener(\'click\', (e) => {\n        if (e.target === qrModal) {\n          closeModal();\n        }\n      });\n    }\n  })();\n</script></main><nav class=\"fixed bottom-0 inset-x-0 z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-2px_10px_rgba(0,0,0,0.04)]\" data-active-classes=\"text-primary font-label-md\"><div class=\"flex justify-around items-center h-16 px-space-xs\"><a class=\"flex flex-col items-center justify-center min-w-[64px] min-h-[44px] gap-0.5 text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"inicio\" href=\"#\"><span class=\"material-symbols-outlined text-[24px]\">calendar_today</span><span class=\"font-label-sm text-label-sm\">In\303\255cio</span></a><a class=\"flex flex-col items-center justify-center min-w-[64px] min-h-[44px] gap-0.5 text-on-surface-variant hover:text-on-surface transition-colors\" data-path=\"nova-reserva\" href=\"#\"><div class=\"w-8 h-8 rounded-full bg-primary-container text-on-primary flex items-center justify-center shadow-sm\"><span class=\"material-symbols-outlined text-[20px]\">add</span></div><span class=\"font-label-sm text-label-sm\">Reservar</span
etween\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Lota\303\247\303\243o M\303\241xima</span>\n<span class=\"font-title-md text-title-md text-outline font-semibold\">30 Computadores iMac</span>\n</div>\n<span class=\"font-body-sm text-body-sm text-error font-medium\">Faltam 2 assentos</span>\n</div>\n<div class=\"flex flex-wrap gap-1.5\">\n<span class=\"px-2.5 py-1 rounded-full bg-surface-container text-outline font-label-sm text-label-sm\">VS Code</span>\n<span class=\"px-2.5 py-1 rounded-full bg-surface-container text-outline font-label-sm text-label-sm\">Android Studio</span>\n<span class=\"px-2.5 py-1 rounded-full bg-surface-container text-outline font-label-sm text-label-sm\">Xcode</span>\n</div>\n<button class=\"w-full mt-2 h-12 rounded-lg bg-surface-container-high text-outline font-label-lg text-label-lg font-medium flex items-center justify-center gap-2 cursor-not-allowed\" disabled=\"\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">lock</span>\n        Indispon\303\255vel para esta turma\n      </button>\n</article>\n</div>\n<!-- Barra de Conclus\303\243o / Bottom Sticky Sheet Trigger -->\n<div class=\"px-gutter pt-space-sm pb-space-lg flex flex-col gap-space-xs\">\n<div class=\"bg-surface-container rounded-xl p-space-sm flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[22px]\">check_circle</span>\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Laborat\303\263rio Selecionado</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\" id=\"selected-lab-title\">Laborat\303\263rio 04 - Desenvolvimento</span>\n</div>\n</div>\n<span class=\"px-2 py-1 rounded bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-semibold\">Pronto</span>\n</div>\n<button class=\"w-full h-12 rounded-lg bg-primary text-on-primary font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 shadow-md active:scale-[0.98] transition-all\" type=\"button\">\n<span>Avan\303\247ar para Revis\303\243o</span>\n<span class=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n</button>\n</div>\n</div>\n<script>\n  let currentSelected = 1;\n\n  function selectLab(id) {\n    if (id === 3) return;\n    currentSelected = id;\n\n    const btn1 = document.getElementById(\'btn-select-1\');\n    const label1 = document.getElementById(\'label-select-1\');\n    const icon1 = document.getElementById(\'icon-select-1\');\n\n    const btn2 = document.getElementById(\'btn-select-2\');\n    const label2 = document.getElementById(\'label-select-2\');\n    const icon2 = document.getElementById(\'icon-select-2\');\n\n    const summaryTitle = document.getElementById(\'selected-lab-title\');\n\n    if (id === 1) {\n      btn1.className = \'w-full mt-2 h-12 rounded-lg bg-primary-container text-on-primary font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 shadow-sm active:scale-[0.98] transition-all\';\n      label1.textContent = \'Selecionar este Laborat\303\263rio\';\n      icon1.textContent = \'radio_button_checked\';\n\n      btn2.className = \'w-full mt-2 h-12 rounded-lg bg-surface-container text-on-surface font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 active:scale-[0.98] transition-all\';\n      label2.textContent = \'Solicitar com Instala\303\247\303\243o Pr\303\251via\';\n      icon2.textContent = \'handyman\';\n\n      summaryTitle.textContent = \'Laborat\303\263rio 04 - Desenvolvimento\';\n    } else if (id === 2) {\n      btn2.className = \'w-full mt-2 h-12 rounded-lg bg-primary-container text-on-primary font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 shadow-sm active:scale-[0.98] transition-all\';\n      label2.textContent = \'Selecionado (Requer TI)\';\n     